{
 "cards": [
  {
   "start": 0.0,
   "end": 1.18,
   "text": "In six weeks,"
  },
  {
   "start": 1.18,
   "end": 2.14,
   "text": "this woman stopped"
  },
  {
   "start": 2.14,
   "end": 2.9,
   "text": "coming down her"
  },
  {
   "start": 2.9,
   "end": 4.66,
   "text": "own stairs backwards."
  },
  {
   "start": 4.66,
   "end": 6.06,
   "text": "Without an operation."
  },
  {
   "start": 6.06,
   "end": 7.0,
   "text": "Without another course"
  },
  {
   "start": 7.0,
   "end": 7.84,
   "text": "of physio."
  },
  {
   "start": 7.84,
   "end": 9.06,
   "text": "Without one more brace"
  },
  {
   "start": 9.06,
   "end": 10.28,
   "text": "going in the drawer."
  },
  {
   "start": 10.28,
   "end": 11.04,
   "text": "And here is"
  },
  {
   "start": 11.04,
   "end": 11.7,
   "text": "how you can"
  },
  {
   "start": 11.7,
   "end": 12.583,
   "text": "do that too."
  },
  {
   "start": 12.583,
   "end": 14.063,
   "text": "A patient of mine."
  },
  {
   "start": 14.063,
   "end": 14.883,
   "text": "Nine years of"
  },
  {
   "start": 14.883,
   "end": 15.723,
   "text": "knee pain."
  },
  {
   "start": 15.723,
   "end": 16.243,
   "text": "Bone on bone"
  },
  {
   "start": 16.243,
   "end": 17.103,
   "text": "on the left,"
  },
  {
   "start": 17.103,
   "end": 17.643,
   "text": "the right one"
  },
  {
   "start": 17.643,
   "end": 18.743,
   "text": "following it."
  },
  {
   "start": 18.743,
   "end": 19.163,
   "text": "Here is what"
  },
  {
   "start": 19.163,
   "end": 19.923,
   "text": "her scan does"
  },
  {
   "start": 19.923,
   "end": 21.283,
   "text": "not show you."
  },
  {
   "start": 21.283,
   "end": 22.683,
   "text": "Two centimetres below your"
  },
  {
   "start": 22.683,
   "end": 23.663,
   "text": "kneecap there is a"
  },
  {
   "start": 23.663,
   "end": 24.443,
   "text": "band of tendon"
  },
  {
   "start": 24.443,
   "end": 25.303,
   "text": "about as wide"
  },
  {
   "start": 25.303,
   "end": 26.443,
   "text": "as your thumb."
  },
  {
   "start": 26.443,
   "end": 27.623,
   "text": "Every step you take"
  },
  {
   "start": 27.623,
   "end": 28.543,
   "text": "lands on it."
  },
  {
   "start": 28.543,
   "end": 31.023,
   "text": "Seventeen times your bodyweight."
  },
  {
   "start": 31.023,
   "end": 31.843,
   "text": "Put your finger under"
  },
  {
   "start": 31.843,
   "end": 33.383,
   "text": "your kneecap and press."
  },
  {
   "start": 33.383,
   "end": 34.483,
   "text": "That band is the"
  },
  {
   "start": 34.483,
   "end": 35.663,
   "text": "one taking it."
  },
  {
   "start": 35.663,
   "end": 36.823,
   "text": "Coming down is worse"
  },
  {
   "start": 36.823,
   "end": 37.983,
   "text": "than going up."
  },
  {
   "start": 37.983,
   "end": 38.503,
   "text": "Going up,"
  },
  {
   "start": 38.503,
   "end": 40.023,
   "text": "your muscles lift you."
  },
  {
   "start": 40.023,
   "end": 40.903,
   "text": "Coming down,"
  },
  {
   "start": 40.903,
   "end": 41.943,
   "text": "you are catching yourself,"
  },
  {
   "start": 41.943,
   "end": 43.263,
   "text": "and the catch lands"
  },
  {
   "start": 43.263,
   "end": 44.393,
   "text": "on that band."
  },
  {
   "start": 44.643,
   "end": 45.383,
   "text": "That is why she"
  },
  {
   "start": 45.383,
   "end": 46.553,
   "text": "came down backwards."
  },
  {
   "start": 46.823,
   "end": 47.783,
   "text": "Backwards takes the"
  },
  {
   "start": 47.783,
   "end": 48.603,
   "text": "catch out."
  },
  {
   "start": 48.603,
   "end": 49.243,
   "text": "That is why the"
  },
  {
   "start": 49.243,
   "end": 51.123,
   "text": "chair took three tries."
  },
  {
   "start": 51.123,
   "end": 51.903,
   "text": "That is why the"
  },
  {
   "start": 51.903,
   "end": 52.943,
   "text": "good knee started going"
  },
  {
   "start": 52.943,
   "end": 54.003,
   "text": "the same way."
  },
  {
   "start": 54.003,
   "end": 54.803,
   "text": "She had been leading"
  },
  {
   "start": 54.803,
   "end": 56.033,
   "text": "with it for years."
  },
  {
   "start": 56.383,
   "end": 57.003,
   "text": "And the list of"
  },
  {
   "start": 57.003,
   "end": 57.623,
   "text": "things she said"
  },
  {
   "start": 57.623,
   "end": 58.403,
   "text": "no to got"
  },
  {
   "start": 58.403,
   "end": 60.043,
   "text": "longer every year."
  },
  {
   "start": 60.043,
   "end": 61.063,
   "text": "The long walk."
  },
  {
   "start": 61.063,
   "end": 61.803,
   "text": "The garden."
  },
  {
   "start": 61.803,
   "end": 62.623,
   "text": "Her family coming"
  },
  {
   "start": 62.623,
   "end": 63.543,
   "text": "to her instead."
  },
  {
   "start": 63.543,
   "end": 64.983,
   "text": "It was never how"
  },
  {
   "start": 64.983,
   "end": 66.083,
   "text": "hard she tried."
  },
  {
   "start": 66.083,
   "end": 66.703,
   "text": "It was never"
  },
  {
   "start": 66.703,
   "end": 67.803,
   "text": "a weak muscle."
  },
  {
   "start": 67.803,
   "end": 68.743,
   "text": "It was where the"
  },
  {
   "start": 68.743,
   "end": 70.143,
   "text": "load was landing."
  },
  {
   "start": 70.143,
   "end": 71.183,
   "text": "A sleeve squeezes"
  },
  {
   "start": 71.183,
   "end": 72.323,
   "text": "the whole knee."
  },
  {
   "start": 72.323,
   "end": 73.363,
   "text": "A hinged brace stops"
  },
  {
   "start": 73.363,
   "end": 74.203,
   "text": "it going sideways,"
  },
  {
   "start": 74.203,
   "end": 75.083,
   "text": "and her knee was"
  },
  {
   "start": 75.083,
   "end": 76.683,
   "text": "never going sideways."
  },
  {
   "start": 76.683,
   "end": 77.483,
   "text": "A gel sits"
  },
  {
   "start": 77.483,
   "end": 78.643,
   "text": "on the skin."
  },
  {
   "start": 78.643,
   "end": 79.123,
   "text": "None of them"
  },
  {
   "start": 79.123,
   "end": 80.323,
   "text": "move the load."
  },
  {
   "start": 80.323,
   "end": 81.523,
   "text": "This does."
  },
  {
   "start": 81.523,
   "end": 83.043,
   "text": "It is called Stryde."
  },
  {
   "start": 83.043,
   "end": 84.383,
   "text": "It sits two centimetres"
  },
  {
   "start": 84.383,
   "end": 85.323,
   "text": "below the kneecap,"
  },
  {
   "start": 85.323,
   "end": 86.423,
   "text": "on the tendon."
  },
  {
   "start": 86.423,
   "end": 87.383,
   "text": "It never crosses"
  },
  {
   "start": 87.383,
   "end": 88.283,
   "text": "the joint."
  },
  {
   "start": 88.283,
   "end": 89.623,
   "text": "A silicone pad inside"
  },
  {
   "start": 89.623,
   "end": 90.903,
   "text": "holds pressure on that"
  },
  {
   "start": 90.903,
   "end": 92.343,
   "text": "one band instead of"
  },
  {
   "start": 92.343,
   "end": 93.003,
   "text": "spreading it round"
  },
  {
   "start": 93.003,
   "end": 94.163,
   "text": "the whole knee."
  },
  {
   "start": 94.163,
   "end": 95.203,
   "text": "The weight gets caught"
  },
  {
   "start": 95.203,
   "end": 96.343,
   "text": "and moved off the"
  },
  {
   "start": 96.343,
   "end": 97.563,
   "text": "worn part before it"
  },
  {
   "start": 97.563,
   "end": 98.743,
   "text": "reaches the joint."
  },
  {
   "start": 98.743,
   "end": 99.643,
   "text": "The placement is"
  },
  {
   "start": 99.643,
   "end": 100.763,
   "text": "the whole thing."
  },
  {
   "start": 100.763,
   "end": 101.983,
   "text": "A centimetre too high"
  },
  {
   "start": 101.983,
   "end": 102.443,
   "text": "and it is"
  },
  {
   "start": 102.443,
   "end": 103.223,
   "text": "a sleeve again."
  },
  {
   "start": 103.223,
   "end": 104.583,
   "text": "Thirty four percent"
  },
  {
   "start": 104.583,
   "end": 105.803,
   "text": "less strain."
  },
  {
   "start": 105.803,
   "end": 106.123,
   "text": "Measured."
  },
  {
   "start": 106.123,
   "end": 107.263,
   "text": "Three years with"
  },
  {
   "start": 107.263,
   "end": 108.283,
   "text": "orthopedic surgeons."
  },
  {
   "start": 108.283,
   "end": 109.803,
   "text": "Two hundred thousand"
  },
  {
   "start": 109.803,
   "end": 110.743,
   "text": "people wearing one."
  },
  {
   "start": 110.743,
   "end": 111.843,
   "text": "Ten seconds to"
  },
  {
   "start": 111.843,
   "end": 112.503,
   "text": "put on."
  },
  {
   "start": 112.503,
   "end": 113.443,
   "text": "No sores,"
  },
  {
   "start": 113.443,
   "end": 114.463,
   "text": "no rolling down,"
  },
  {
   "start": 114.463,
   "end": 115.223,
   "text": "and nobody can"
  },
  {
   "start": 115.223,
   "end": 115.923,
   "text": "see it."
  },
  {
   "start": 115.923,
   "end": 116.583,
   "text": "I do not sell"
  },
  {
   "start": 116.583,
   "end": 117.343,
   "text": "these and I make"
  },
  {
   "start": 117.343,
   "end": 118.663,
   "text": "nothing from saying this."
  },
  {
   "start": 118.663,
   "end": 119.503,
   "text": "I say it"
  },
  {
   "start": 119.503,
   "end": 120.143,
   "text": "before we talk"
  },
  {
   "start": 120.143,
   "end": 121.123,
   "text": "about anything else,"
  },
  {
   "start": 121.123,
   "end": 121.903,
   "text": "because it is the"
  },
  {
   "start": 121.903,
   "end": 122.663,
   "text": "cheapest thing on the"
  },
  {
   "start": 122.663,
   "end": 123.363,
   "text": "list and the"
  },
  {
   "start": 123.363,
   "end": 124.263,
   "text": "only one aimed"
  },
  {
   "start": 124.263,
   "end": 125.223,
   "text": "at the band."
  },
  {
   "start": 125.223,
   "end": 125.883,
   "text": "You do not have"
  },
  {
   "start": 125.883,
   "end": 126.463,
   "text": "to take my"
  },
  {
   "start": 126.463,
   "end": 127.583,
   "text": "word for it."
  },
  {
   "start": 127.583,
   "end": 128.763,
   "text": "One knee only."
  },
  {
   "start": 128.763,
   "end": 129.943,
   "text": "Leave the other bare."
  },
  {
   "start": 129.943,
   "end": 130.383,
   "text": "Go to your"
  },
  {
   "start": 130.383,
   "end": 131.203,
   "text": "own stairs and"
  },
  {
   "start": 131.203,
   "end": 132.543,
   "text": "come down forwards."
  },
  {
   "start": 132.543,
   "end": 133.063,
   "text": "You will know"
  },
  {
   "start": 133.063,
   "end": 133.963,
   "text": "in a minute."
  },
  {
   "start": 133.963,
   "end": 134.743,
   "text": "Not because the"
  },
  {
   "start": 134.743,
   "end": 136.163,
   "text": "arthritis has gone."
  },
  {
   "start": 136.163,
   "end": 137.463,
   "text": "Her scan looks exactly"
  },
  {
   "start": 137.463,
   "end": 138.123,
   "text": "the same as it"
  },
  {
   "start": 138.123,
   "end": 139.163,
   "text": "did in March."
  },
  {
   "start": 139.163,
   "end": 139.823,
   "text": "I have both"
  },
  {
   "start": 139.823,
   "end": 140.563,
   "text": "of them."
  },
  {
   "start": 140.563,
   "end": 141.523,
   "text": "Because the load is"
  },
  {
   "start": 141.523,
   "end": 142.603,
   "text": "not landing on that"
  },
  {
   "start": 142.603,
   "end": 143.703,
   "text": "band any more."
  },
  {
   "start": 143.703,
   "end": 145.083,
   "text": "You cannot strengthen your"
  },
  {
   "start": 145.083,
   "end": 145.563,
   "text": "way out of"
  },
  {
   "start": 145.563,
   "end": 146.623,
   "text": "a load problem."
  },
  {
   "start": 146.623,
   "end": 147.403,
   "text": "You have to"
  },
  {
   "start": 147.403,
   "end": 148.263,
   "text": "move the load."
  },
  {
   "start": 148.263,
   "end": 149.483,
   "text": "Two for one,"
  },
  {
   "start": 149.483,
   "end": 149.823,
   "text": "so you do"
  },
  {
   "start": 149.823,
   "end": 150.463,
   "text": "both knees,"
  },
  {
   "start": 150.463,
   "end": 151.023,
   "text": "which is what"
  },
  {
   "start": 151.023,
   "end": 151.543,
   "text": "she needed."
  },
  {
   "start": 151.543,
   "end": 152.563,
   "text": "Sixty days,"
  },
  {
   "start": 152.563,
   "end": 153.303,
   "text": "and you keep"
  },
  {
   "start": 153.303,
   "end": 154.283,
   "text": "the straps."
  },
  {
   "start": 154.283,
   "end": 155.543,
   "text": "From the Stryde site."
  },
  {
   "start": 155.543,
   "end": 156.343,
   "text": "The copies stretch,"
  },
  {
   "start": 156.343,
   "end": 157.743,
   "text": "and a stretched strap"
  },
  {
   "start": 157.743,
   "end": 159.543,
   "text": "stops holding the spot."
  },
  {
   "start": 159.543,
   "end": 160.203,
   "text": "Nothing to lose"
  },
  {
   "start": 160.203,
   "end": 161.243,
   "text": "but the pain."
  },
  {
   "start": 161.243,
   "end": 161.603,
   "text": "Go and do"
  },
  {
   "start": 161.603,
   "end": 162.443,
   "text": "your stairs."
  }
 ]
}