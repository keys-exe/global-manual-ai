{
 "cards": [
  {
   "start": 0.0,
   "end": 1.18,
   "text": "In six weeks,"
  },
  {
   "start": 1.18,
   "end": 2.14,
   "text": "this woman stopped"
  },
  {
   "start": 2.14,
   "end": 2.88,
   "text": "coming down her"
  },
  {
   "start": 2.88,
   "end": 4.54,
   "text": "own stairs backwards."
  },
  {
   "start": 4.54,
   "end": 5.74,
   "text": "Without an operation."
  },
  {
   "start": 5.74,
   "end": 6.68,
   "text": "Without another course"
  },
  {
   "start": 6.68,
   "end": 7.54,
   "text": "of physio."
  },
  {
   "start": 7.54,
   "end": 8.76,
   "text": "Without one more brace"
  },
  {
   "start": 8.76,
   "end": 9.96,
   "text": "going in the drawer."
  },
  {
   "start": 9.96,
   "end": 10.72,
   "text": "And here is"
  },
  {
   "start": 10.72,
   "end": 11.38,
   "text": "how you can"
  },
  {
   "start": 11.38,
   "end": 12.167,
   "text": "do that too."
  },
  {
   "start": 12.167,
   "end": 13.547,
   "text": "A patient of mine."
  },
  {
   "start": 13.547,
   "end": 14.847,
   "text": "Nine years of"
  },
  {
   "start": 14.847,
   "end": 15.687,
   "text": "knee pain."
  },
  {
   "start": 15.687,
   "end": 16.207,
   "text": "Bone on bone"
  },
  {
   "start": 16.207,
   "end": 17.067,
   "text": "on the left,"
  },
  {
   "start": 17.067,
   "end": 17.607,
   "text": "the right one"
  },
  {
   "start": 17.607,
   "end": 18.687,
   "text": "following it."
  },
  {
   "start": 18.687,
   "end": 19.127,
   "text": "Here is what"
  },
  {
   "start": 19.127,
   "end": 19.887,
   "text": "her scan does"
  },
  {
   "start": 19.887,
   "end": 20.887,
   "text": "not show you."
  },
  {
   "start": 20.887,
   "end": 22.647,
   "text": "Two centimetres below your"
  },
  {
   "start": 22.647,
   "end": 23.627,
   "text": "kneecap there is a"
  },
  {
   "start": 23.627,
   "end": 24.387,
   "text": "band of tendon"
  },
  {
   "start": 24.387,
   "end": 25.267,
   "text": "about as wide"
  },
  {
   "start": 25.267,
   "end": 26.387,
   "text": "as your thumb."
  },
  {
   "start": 26.387,
   "end": 27.567,
   "text": "Every step you take"
  },
  {
   "start": 27.567,
   "end": 28.487,
   "text": "lands on it."
  },
  {
   "start": 28.487,
   "end": 30.967,
   "text": "Seventeen times your bodyweight."
  },
  {
   "start": 30.967,
   "end": 31.787,
   "text": "Put your finger under"
  },
  {
   "start": 31.787,
   "end": 33.347,
   "text": "your kneecap and press."
  },
  {
   "start": 33.347,
   "end": 34.447,
   "text": "That band is the"
  },
  {
   "start": 34.447,
   "end": 35.607,
   "text": "one taking it."
  },
  {
   "start": 35.607,
   "end": 36.767,
   "text": "Coming down is worse"
  },
  {
   "start": 36.767,
   "end": 37.927,
   "text": "than going up."
  },
  {
   "start": 37.927,
   "end": 38.627,
   "text": "Going up,"
  },
  {
   "start": 38.627,
   "end": 39.947,
   "text": "your muscles lift you."
  },
  {
   "start": 39.947,
   "end": 40.587,
   "text": "Coming down,"
  },
  {
   "start": 40.587,
   "end": 41.907,
   "text": "you are catching yourself,"
  },
  {
   "start": 41.907,
   "end": 43.247,
   "text": "and the catch lands"
  },
  {
   "start": 43.247,
   "end": 44.447,
   "text": "on that band."
  },
  {
   "start": 44.447,
   "end": 45.147,
   "text": "That is why she"
  },
  {
   "start": 45.147,
   "end": 46.317,
   "text": "came down backwards."
  },
  {
   "start": 46.587,
   "end": 47.547,
   "text": "Backwards takes the"
  },
  {
   "start": 47.547,
   "end": 48.387,
   "text": "catch out."
  },
  {
   "start": 48.387,
   "end": 49.027,
   "text": "That is why the"
  },
  {
   "start": 49.027,
   "end": 50.827,
   "text": "chair took three tries."
  },
  {
   "start": 50.827,
   "end": 51.667,
   "text": "That is why the"
  },
  {
   "start": 51.667,
   "end": 52.707,
   "text": "good knee started going"
  },
  {
   "start": 52.707,
   "end": 53.747,
   "text": "the same way."
  },
  {
   "start": 53.747,
   "end": 54.547,
   "text": "She had been leading"
  },
  {
   "start": 54.547,
   "end": 55.947,
   "text": "with it for years."
  },
  {
   "start": 55.947,
   "end": 56.607,
   "text": "And the list of"
  },
  {
   "start": 56.607,
   "end": 57.227,
   "text": "things she said"
  },
  {
   "start": 57.227,
   "end": 58.007,
   "text": "no to got"
  },
  {
   "start": 58.007,
   "end": 59.647,
   "text": "longer every year."
  },
  {
   "start": 59.647,
   "end": 60.687,
   "text": "The long walk."
  },
  {
   "start": 60.687,
   "end": 61.407,
   "text": "The garden."
  },
  {
   "start": 61.407,
   "end": 62.227,
   "text": "Her family coming"
  },
  {
   "start": 62.227,
   "end": 63.467,
   "text": "to her instead."
  },
  {
   "start": 63.467,
   "end": 64.447,
   "text": "It was never how"
  },
  {
   "start": 64.447,
   "end": 65.507,
   "text": "hard she tried."
  },
  {
   "start": 65.507,
   "end": 66.167,
   "text": "It was never"
  },
  {
   "start": 66.167,
   "end": 67.187,
   "text": "a weak muscle."
  },
  {
   "start": 67.187,
   "end": 68.227,
   "text": "It was where the"
  },
  {
   "start": 68.227,
   "end": 69.147,
   "text": "load was landing."
  },
  {
   "start": 69.147,
   "end": 70.527,
   "text": "A sleeve squeezes"
  },
  {
   "start": 70.527,
   "end": 71.647,
   "text": "the whole knee."
  },
  {
   "start": 71.647,
   "end": 72.707,
   "text": "A hinged brace stops"
  },
  {
   "start": 72.707,
   "end": 73.747,
   "text": "it going sideways,"
  },
  {
   "start": 73.747,
   "end": 74.287,
   "text": "and her knee was"
  },
  {
   "start": 74.287,
   "end": 75.767,
   "text": "never going sideways."
  },
  {
   "start": 75.767,
   "end": 76.587,
   "text": "A gel sits"
  },
  {
   "start": 76.587,
   "end": 77.727,
   "text": "on the skin."
  },
  {
   "start": 77.727,
   "end": 78.187,
   "text": "None of them"
  },
  {
   "start": 78.187,
   "end": 79.427,
   "text": "move the load."
  },
  {
   "start": 79.427,
   "end": 80.587,
   "text": "This does."
  },
  {
   "start": 80.587,
   "end": 82.027,
   "text": "It is called Stryde."
  },
  {
   "start": 82.027,
   "end": 83.207,
   "text": "It sits two centimetres"
  },
  {
   "start": 83.207,
   "end": 84.307,
   "text": "below the kneecap,"
  },
  {
   "start": 84.307,
   "end": 85.387,
   "text": "on the tendon."
  },
  {
   "start": 85.387,
   "end": 86.347,
   "text": "It never crosses"
  },
  {
   "start": 86.347,
   "end": 87.267,
   "text": "the joint."
  },
  {
   "start": 87.267,
   "end": 88.587,
   "text": "A silicone pad inside"
  },
  {
   "start": 88.587,
   "end": 89.867,
   "text": "holds pressure on that"
  },
  {
   "start": 89.867,
   "end": 91.307,
   "text": "one band instead of"
  },
  {
   "start": 91.307,
   "end": 91.967,
   "text": "spreading it round"
  },
  {
   "start": 91.967,
   "end": 93.087,
   "text": "the whole knee."
  },
  {
   "start": 93.087,
   "end": 94.147,
   "text": "The weight gets caught"
  },
  {
   "start": 94.147,
   "end": 95.327,
   "text": "and moved off the"
  },
  {
   "start": 95.327,
   "end": 96.527,
   "text": "worn part before it"
  },
  {
   "start": 96.527,
   "end": 97.727,
   "text": "reaches the joint."
  },
  {
   "start": 97.727,
   "end": 98.647,
   "text": "The placement is"
  },
  {
   "start": 98.647,
   "end": 99.727,
   "text": "the whole thing."
  },
  {
   "start": 99.727,
   "end": 100.967,
   "text": "A centimetre too high"
  },
  {
   "start": 100.967,
   "end": 101.427,
   "text": "and it is"
  },
  {
   "start": 101.427,
   "end": 102.187,
   "text": "a sleeve again."
  },
  {
   "start": 102.187,
   "end": 103.367,
   "text": "Thirty four percent"
  },
  {
   "start": 103.367,
   "end": 104.647,
   "text": "less strain."
  },
  {
   "start": 104.647,
   "end": 104.987,
   "text": "Measured."
  },
  {
   "start": 104.987,
   "end": 106.127,
   "text": "Three years with"
  },
  {
   "start": 106.127,
   "end": 107.119,
   "text": "orthopedic surgeons."
  },
  {
   "start": 107.119,
   "end": 108.607,
   "text": "Two hundred thousand"
  },
  {
   "start": 108.607,
   "end": 109.527,
   "text": "people wearing one."
  },
  {
   "start": 109.527,
   "end": 110.627,
   "text": "Ten seconds to"
  },
  {
   "start": 110.627,
   "end": 111.287,
   "text": "put on."
  },
  {
   "start": 111.287,
   "end": 112.227,
   "text": "No sores,"
  },
  {
   "start": 112.227,
   "end": 113.247,
   "text": "no rolling down,"
  },
  {
   "start": 113.247,
   "end": 113.987,
   "text": "and nobody can"
  },
  {
   "start": 113.987,
   "end": 114.667,
   "text": "see it."
  },
  {
   "start": 114.667,
   "end": 115.347,
   "text": "I do not sell"
  },
  {
   "start": 115.347,
   "end": 116.107,
   "text": "these and I make"
  },
  {
   "start": 116.107,
   "end": 117.667,
   "text": "nothing from saying this."
  },
  {
   "start": 117.667,
   "end": 118.267,
   "text": "I say it"
  },
  {
   "start": 118.267,
   "end": 118.927,
   "text": "before we talk"
  },
  {
   "start": 118.927,
   "end": 119.907,
   "text": "about anything else,"
  },
  {
   "start": 119.907,
   "end": 120.667,
   "text": "because it is the"
  },
  {
   "start": 120.667,
   "end": 121.427,
   "text": "cheapest thing on the"
  },
  {
   "start": 121.427,
   "end": 122.147,
   "text": "list and the"
  },
  {
   "start": 122.147,
   "end": 123.007,
   "text": "only one aimed"
  },
  {
   "start": 123.007,
   "end": 123.627,
   "text": "at the band."
  },
  {
   "start": 123.627,
   "end": 124.667,
   "text": "You do not have"
  },
  {
   "start": 124.667,
   "end": 125.247,
   "text": "to take my"
  },
  {
   "start": 125.247,
   "end": 126.387,
   "text": "word for it."
  },
  {
   "start": 126.387,
   "end": 127.447,
   "text": "One knee only."
  },
  {
   "start": 127.447,
   "end": 128.567,
   "text": "Leave the other bare."
  },
  {
   "start": 128.567,
   "end": 129.007,
   "text": "Go to your"
  },
  {
   "start": 129.007,
   "end": 129.807,
   "text": "own stairs and"
  },
  {
   "start": 129.807,
   "end": 131.207,
   "text": "come down forwards."
  },
  {
   "start": 131.207,
   "end": 131.687,
   "text": "You will know"
  },
  {
   "start": 131.687,
   "end": 132.707,
   "text": "in a minute."
  },
  {
   "start": 132.707,
   "end": 133.347,
   "text": "Not because the"
  },
  {
   "start": 133.347,
   "end": 134.767,
   "text": "arthritis has gone."
  },
  {
   "start": 134.767,
   "end": 136.067,
   "text": "Her scan looks exactly"
  },
  {
   "start": 136.067,
   "end": 136.727,
   "text": "the same as it"
  },
  {
   "start": 136.727,
   "end": 137.807,
   "text": "did in March."
  },
  {
   "start": 137.807,
   "end": 138.367,
   "text": "I have both"
  },
  {
   "start": 138.367,
   "end": 139.147,
   "text": "of them."
  },
  {
   "start": 139.147,
   "end": 140.067,
   "text": "Because the load is"
  },
  {
   "start": 140.067,
   "end": 141.167,
   "text": "not landing on that"
  },
  {
   "start": 141.167,
   "end": 142.247,
   "text": "band any more."
  },
  {
   "start": 142.247,
   "end": 143.587,
   "text": "You cannot strengthen your"
  },
  {
   "start": 143.587,
   "end": 144.067,
   "text": "way out of"
  },
  {
   "start": 144.067,
   "end": 145.167,
   "text": "a load problem."
  },
  {
   "start": 145.167,
   "end": 145.907,
   "text": "You have to"
  },
  {
   "start": 145.907,
   "end": 147.147,
   "text": "move the load."
  },
  {
   "start": 147.147,
   "end": 147.947,
   "text": "Two for one,"
  },
  {
   "start": 147.947,
   "end": 148.327,
   "text": "so you do"
  },
  {
   "start": 148.327,
   "end": 149.107,
   "text": "both knees,"
  },
  {
   "start": 149.107,
   "end": 149.507,
   "text": "which is what"
  },
  {
   "start": 149.507,
   "end": 150.027,
   "text": "she needed."
  },
  {
   "start": 150.027,
   "end": 150.987,
   "text": "Sixty days,"
  },
  {
   "start": 150.987,
   "end": 151.727,
   "text": "and you keep"
  },
  {
   "start": 151.727,
   "end": 152.707,
   "text": "the straps."
  },
  {
   "start": 152.707,
   "end": 153.947,
   "text": "From the Stryde site."
  },
  {
   "start": 153.947,
   "end": 154.767,
   "text": "The copies stretch,"
  },
  {
   "start": 154.767,
   "end": 156.147,
   "text": "and a stretched strap"
  },
  {
   "start": 156.147,
   "end": 157.987,
   "text": "stops holding the spot."
  },
  {
   "start": 157.987,
   "end": 158.607,
   "text": "Nothing to lose"
  },
  {
   "start": 158.607,
   "end": 159.627,
   "text": "but the pain."
  },
  {
   "start": 159.627,
   "end": 159.967,
   "text": "Go and do"
  },
  {
   "start": 159.967,
   "end": 160.727,
   "text": "your stairs."
  }
 ]
}