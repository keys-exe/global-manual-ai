{
 "cards": [
  {
   "start": 0.0,
   "end": 0.96,
   "text": "I am a doctor,"
  },
  {
   "start": 0.96,
   "end": 1.74,
   "text": "and I am going"
  },
  {
   "start": 1.74,
   "end": 2.38,
   "text": "to tell you to"
  },
  {
   "start": 2.38,
   "end": 3.82,
   "text": "do something before you"
  },
  {
   "start": 3.82,
   "end": 4.48,
   "text": "come and see me"
  },
  {
   "start": 4.48,
   "end": 5.64,
   "text": "about your knee."
  },
  {
   "start": 5.64,
   "end": 6.8,
   "text": "It takes ten seconds"
  },
  {
   "start": 6.8,
   "end": 7.62,
   "text": "and it is"
  },
  {
   "start": 7.62,
   "end": 8.625,
   "text": "not a prescription."
  },
  {
   "start": 8.625,
   "end": 10.005,
   "text": "A patient of mine."
  },
  {
   "start": 10.005,
   "end": 11.305,
   "text": "Nine years of"
  },
  {
   "start": 11.305,
   "end": 12.145,
   "text": "knee pain."
  },
  {
   "start": 12.145,
   "end": 12.665,
   "text": "Bone on bone"
  },
  {
   "start": 12.665,
   "end": 13.525,
   "text": "on the left,"
  },
  {
   "start": 13.525,
   "end": 14.065,
   "text": "the right one"
  },
  {
   "start": 14.065,
   "end": 15.145,
   "text": "following it."
  },
  {
   "start": 15.145,
   "end": 15.585,
   "text": "Here is what"
  },
  {
   "start": 15.585,
   "end": 16.345,
   "text": "her scan does"
  },
  {
   "start": 16.345,
   "end": 17.345,
   "text": "not show you."
  },
  {
   "start": 17.345,
   "end": 19.105,
   "text": "Two centimetres below your"
  },
  {
   "start": 19.105,
   "end": 20.085,
   "text": "kneecap there is a"
  },
  {
   "start": 20.085,
   "end": 20.845,
   "text": "band of tendon"
  },
  {
   "start": 20.845,
   "end": 21.725,
   "text": "about as wide"
  },
  {
   "start": 21.725,
   "end": 22.845,
   "text": "as your thumb."
  },
  {
   "start": 22.845,
   "end": 24.025,
   "text": "Every step you take"
  },
  {
   "start": 24.025,
   "end": 24.945,
   "text": "lands on it."
  },
  {
   "start": 24.945,
   "end": 27.425,
   "text": "Seventeen times your bodyweight."
  },
  {
   "start": 27.425,
   "end": 28.245,
   "text": "Put your finger under"
  },
  {
   "start": 28.245,
   "end": 29.805,
   "text": "your kneecap and press."
  },
  {
   "start": 29.805,
   "end": 30.905,
   "text": "That band is the"
  },
  {
   "start": 30.905,
   "end": 32.065,
   "text": "one taking it."
  },
  {
   "start": 32.065,
   "end": 33.225,
   "text": "Coming down is worse"
  },
  {
   "start": 33.225,
   "end": 34.385,
   "text": "than going up."
  },
  {
   "start": 34.385,
   "end": 35.085,
   "text": "Going up,"
  },
  {
   "start": 35.085,
   "end": 36.405,
   "text": "your muscles lift you."
  },
  {
   "start": 36.405,
   "end": 37.045,
   "text": "Coming down,"
  },
  {
   "start": 37.045,
   "end": 38.365,
   "text": "you are catching yourself,"
  },
  {
   "start": 38.365,
   "end": 39.705,
   "text": "and the catch lands"
  },
  {
   "start": 39.705,
   "end": 40.905,
   "text": "on that band."
  },
  {
   "start": 40.905,
   "end": 41.605,
   "text": "That is why she"
  },
  {
   "start": 41.605,
   "end": 42.775,
   "text": "came down backwards."
  },
  {
   "start": 43.045,
   "end": 44.005,
   "text": "Backwards takes the"
  },
  {
   "start": 44.005,
   "end": 44.845,
   "text": "catch out."
  },
  {
   "start": 44.845,
   "end": 45.485,
   "text": "That is why the"
  },
  {
   "start": 45.485,
   "end": 47.285,
   "text": "chair took three tries."
  },
  {
   "start": 47.285,
   "end": 48.125,
   "text": "That is why the"
  },
  {
   "start": 48.125,
   "end": 49.165,
   "text": "good knee started going"
  },
  {
   "start": 49.165,
   "end": 50.205,
   "text": "the same way."
  },
  {
   "start": 50.205,
   "end": 51.005,
   "text": "She had been leading"
  },
  {
   "start": 51.005,
   "end": 52.405,
   "text": "with it for years."
  },
  {
   "start": 52.405,
   "end": 53.065,
   "text": "And the list of"
  },
  {
   "start": 53.065,
   "end": 53.685,
   "text": "things she said"
  },
  {
   "start": 53.685,
   "end": 54.465,
   "text": "no to got"
  },
  {
   "start": 54.465,
   "end": 56.105,
   "text": "longer every year."
  },
  {
   "start": 56.105,
   "end": 57.145,
   "text": "The long walk."
  },
  {
   "start": 57.145,
   "end": 57.865,
   "text": "The garden."
  },
  {
   "start": 57.865,
   "end": 58.685,
   "text": "Her family coming"
  },
  {
   "start": 58.685,
   "end": 59.925,
   "text": "to her instead."
  },
  {
   "start": 59.925,
   "end": 60.905,
   "text": "It was never how"
  },
  {
   "start": 60.905,
   "end": 61.965,
   "text": "hard she tried."
  },
  {
   "start": 61.965,
   "end": 62.625,
   "text": "It was never"
  },
  {
   "start": 62.625,
   "end": 63.645,
   "text": "a weak muscle."
  },
  {
   "start": 63.645,
   "end": 64.685,
   "text": "It was where the"
  },
  {
   "start": 64.685,
   "end": 65.605,
   "text": "load was landing."
  },
  {
   "start": 65.605,
   "end": 66.985,
   "text": "A sleeve squeezes"
  },
  {
   "start": 66.985,
   "end": 68.105,
   "text": "the whole knee."
  },
  {
   "start": 68.105,
   "end": 69.165,
   "text": "A hinged brace stops"
  },
  {
   "start": 69.165,
   "end": 70.205,
   "text": "it going sideways,"
  },
  {
   "start": 70.205,
   "end": 70.745,
   "text": "and her knee was"
  },
  {
   "start": 70.745,
   "end": 72.225,
   "text": "never going sideways."
  },
  {
   "start": 72.225,
   "end": 73.045,
   "text": "A gel sits"
  },
  {
   "start": 73.045,
   "end": 74.185,
   "text": "on the skin."
  },
  {
   "start": 74.185,
   "end": 74.645,
   "text": "None of them"
  },
  {
   "start": 74.645,
   "end": 75.885,
   "text": "move the load."
  },
  {
   "start": 75.885,
   "end": 77.045,
   "text": "This does."
  },
  {
   "start": 77.045,
   "end": 78.485,
   "text": "It is called Stryde."
  },
  {
   "start": 78.485,
   "end": 79.665,
   "text": "It sits two centimetres"
  },
  {
   "start": 79.665,
   "end": 80.765,
   "text": "below the kneecap,"
  },
  {
   "start": 80.765,
   "end": 81.845,
   "text": "on the tendon."
  },
  {
   "start": 81.845,
   "end": 82.805,
   "text": "It never crosses"
  },
  {
   "start": 82.805,
   "end": 83.725,
   "text": "the joint."
  },
  {
   "start": 83.725,
   "end": 85.045,
   "text": "A silicone pad inside"
  },
  {
   "start": 85.045,
   "end": 86.325,
   "text": "holds pressure on that"
  },
  {
   "start": 86.325,
   "end": 87.765,
   "text": "one band instead of"
  },
  {
   "start": 87.765,
   "end": 88.425,
   "text": "spreading it round"
  },
  {
   "start": 88.425,
   "end": 89.545,
   "text": "the whole knee."
  },
  {
   "start": 89.545,
   "end": 90.605,
   "text": "The weight gets caught"
  },
  {
   "start": 90.605,
   "end": 91.785,
   "text": "and moved off the"
  },
  {
   "start": 91.785,
   "end": 92.985,
   "text": "worn part before it"
  },
  {
   "start": 92.985,
   "end": 94.185,
   "text": "reaches the joint."
  },
  {
   "start": 94.185,
   "end": 95.105,
   "text": "The placement is"
  },
  {
   "start": 95.105,
   "end": 96.185,
   "text": "the whole thing."
  },
  {
   "start": 96.185,
   "end": 97.425,
   "text": "A centimetre too high"
  },
  {
   "start": 97.425,
   "end": 97.885,
   "text": "and it is"
  },
  {
   "start": 97.885,
   "end": 98.645,
   "text": "a sleeve again."
  },
  {
   "start": 98.645,
   "end": 99.825,
   "text": "Thirty four percent"
  },
  {
   "start": 99.825,
   "end": 101.105,
   "text": "less strain."
  },
  {
   "start": 101.105,
   "end": 101.445,
   "text": "Measured."
  },
  {
   "start": 101.445,
   "end": 102.585,
   "text": "Three years with"
  },
  {
   "start": 102.585,
   "end": 103.577,
   "text": "orthopedic surgeons."
  },
  {
   "start": 103.577,
   "end": 105.065,
   "text": "Two hundred thousand"
  },
  {
   "start": 105.065,
   "end": 105.985,
   "text": "people wearing one."
  },
  {
   "start": 105.985,
   "end": 107.085,
   "text": "Ten seconds to"
  },
  {
   "start": 107.085,
   "end": 107.745,
   "text": "put on."
  },
  {
   "start": 107.745,
   "end": 108.685,
   "text": "No sores,"
  },
  {
   "start": 108.685,
   "end": 109.705,
   "text": "no rolling down,"
  },
  {
   "start": 109.705,
   "end": 110.445,
   "text": "and nobody can"
  },
  {
   "start": 110.445,
   "end": 111.125,
   "text": "see it."
  },
  {
   "start": 111.125,
   "end": 111.805,
   "text": "I do not sell"
  },
  {
   "start": 111.805,
   "end": 112.565,
   "text": "these and I make"
  },
  {
   "start": 112.565,
   "end": 114.125,
   "text": "nothing from saying this."
  },
  {
   "start": 114.125,
   "end": 114.725,
   "text": "I say it"
  },
  {
   "start": 114.725,
   "end": 115.385,
   "text": "before we talk"
  },
  {
   "start": 115.385,
   "end": 116.365,
   "text": "about anything else,"
  },
  {
   "start": 116.365,
   "end": 117.125,
   "text": "because it is the"
  },
  {
   "start": 117.125,
   "end": 117.885,
   "text": "cheapest thing on the"
  },
  {
   "start": 117.885,
   "end": 118.605,
   "text": "list and the"
  },
  {
   "start": 118.605,
   "end": 119.465,
   "text": "only one aimed"
  },
  {
   "start": 119.465,
   "end": 120.085,
   "text": "at the band."
  },
  {
   "start": 120.085,
   "end": 121.125,
   "text": "You do not have"
  },
  {
   "start": 121.125,
   "end": 121.705,
   "text": "to take my"
  },
  {
   "start": 121.705,
   "end": 122.845,
   "text": "word for it."
  },
  {
   "start": 122.845,
   "end": 123.905,
   "text": "One knee only."
  },
  {
   "start": 123.905,
   "end": 125.025,
   "text": "Leave the other bare."
  },
  {
   "start": 125.025,
   "end": 125.465,
   "text": "Go to your"
  },
  {
   "start": 125.465,
   "end": 126.265,
   "text": "own stairs and"
  },
  {
   "start": 126.265,
   "end": 127.665,
   "text": "come down forwards."
  },
  {
   "start": 127.665,
   "end": 128.145,
   "text": "You will know"
  },
  {
   "start": 128.145,
   "end": 129.165,
   "text": "in a minute."
  },
  {
   "start": 129.165,
   "end": 129.805,
   "text": "Not because the"
  },
  {
   "start": 129.805,
   "end": 131.225,
   "text": "arthritis has gone."
  },
  {
   "start": 131.225,
   "end": 132.525,
   "text": "Her scan looks exactly"
  },
  {
   "start": 132.525,
   "end": 133.185,
   "text": "the same as it"
  },
  {
   "start": 133.185,
   "end": 134.265,
   "text": "did in March."
  },
  {
   "start": 134.265,
   "end": 134.825,
   "text": "I have both"
  },
  {
   "start": 134.825,
   "end": 135.605,
   "text": "of them."
  },
  {
   "start": 135.605,
   "end": 136.525,
   "text": "Because the load is"
  },
  {
   "start": 136.525,
   "end": 137.625,
   "text": "not landing on that"
  },
  {
   "start": 137.625,
   "end": 138.705,
   "text": "band any more."
  },
  {
   "start": 138.705,
   "end": 140.045,
   "text": "You cannot strengthen your"
  },
  {
   "start": 140.045,
   "end": 140.525,
   "text": "way out of"
  },
  {
   "start": 140.525,
   "end": 141.625,
   "text": "a load problem."
  },
  {
   "start": 141.625,
   "end": 142.365,
   "text": "You have to"
  },
  {
   "start": 142.365,
   "end": 143.605,
   "text": "move the load."
  },
  {
   "start": 143.605,
   "end": 144.405,
   "text": "Two for one,"
  },
  {
   "start": 144.405,
   "end": 144.785,
   "text": "so you do"
  },
  {
   "start": 144.785,
   "end": 145.565,
   "text": "both knees,"
  },
  {
   "start": 145.565,
   "end": 145.965,
   "text": "which is what"
  },
  {
   "start": 145.965,
   "end": 146.485,
   "text": "she needed."
  },
  {
   "start": 146.485,
   "end": 147.445,
   "text": "Sixty days,"
  },
  {
   "start": 147.445,
   "end": 148.185,
   "text": "and you keep"
  },
  {
   "start": 148.185,
   "end": 149.165,
   "text": "the straps."
  },
  {
   "start": 149.165,
   "end": 150.405,
   "text": "From the Stryde site."
  },
  {
   "start": 150.405,
   "end": 151.225,
   "text": "The copies stretch,"
  },
  {
   "start": 151.225,
   "end": 152.605,
   "text": "and a stretched strap"
  },
  {
   "start": 152.605,
   "end": 154.445,
   "text": "stops holding the spot."
  },
  {
   "start": 154.445,
   "end": 155.065,
   "text": "Nothing to lose"
  },
  {
   "start": 155.065,
   "end": 156.085,
   "text": "but the pain."
  },
  {
   "start": 156.085,
   "end": 156.425,
   "text": "Go and do"
  },
  {
   "start": 156.425,
   "end": 157.185,
   "text": "your stairs."
  }
 ]
}