{
 "cards": [
  {
   "start": 0.0,
   "end": 1.44,
   "text": "Every week somebody brings"
  },
  {
   "start": 1.44,
   "end": 2.22,
   "text": "me a scan of"
  },
  {
   "start": 2.22,
   "end": 3.16,
   "text": "a knee and asks"
  },
  {
   "start": 3.16,
   "end": 3.94,
   "text": "what can be done"
  },
  {
   "start": 3.94,
   "end": 5.38,
   "text": "about the cartilage."
  },
  {
   "start": 5.38,
   "end": 6.48,
   "text": "I have started answering"
  },
  {
   "start": 6.48,
   "end": 7.833,
   "text": "a different question."
  },
  {
   "start": 7.833,
   "end": 9.313,
   "text": "A patient of mine."
  },
  {
   "start": 9.313,
   "end": 10.133,
   "text": "Nine years of"
  },
  {
   "start": 10.133,
   "end": 10.973,
   "text": "knee pain."
  },
  {
   "start": 10.973,
   "end": 11.493,
   "text": "Bone on bone"
  },
  {
   "start": 11.493,
   "end": 12.353,
   "text": "on the left,"
  },
  {
   "start": 12.353,
   "end": 12.893,
   "text": "the right one"
  },
  {
   "start": 12.893,
   "end": 13.993,
   "text": "following it."
  },
  {
   "start": 13.993,
   "end": 14.413,
   "text": "Here is what"
  },
  {
   "start": 14.413,
   "end": 15.173,
   "text": "her scan does"
  },
  {
   "start": 15.173,
   "end": 16.533,
   "text": "not show you."
  },
  {
   "start": 16.533,
   "end": 17.933,
   "text": "Two centimetres below your"
  },
  {
   "start": 17.933,
   "end": 18.913,
   "text": "kneecap there is a"
  },
  {
   "start": 18.913,
   "end": 19.693,
   "text": "band of tendon"
  },
  {
   "start": 19.693,
   "end": 20.553,
   "text": "about as wide"
  },
  {
   "start": 20.553,
   "end": 21.693,
   "text": "as your thumb."
  },
  {
   "start": 21.693,
   "end": 22.873,
   "text": "Every step you take"
  },
  {
   "start": 22.873,
   "end": 23.793,
   "text": "lands on it."
  },
  {
   "start": 23.793,
   "end": 26.273,
   "text": "Seventeen times your bodyweight."
  },
  {
   "start": 26.273,
   "end": 27.093,
   "text": "Put your finger under"
  },
  {
   "start": 27.093,
   "end": 28.633,
   "text": "your kneecap and press."
  },
  {
   "start": 28.633,
   "end": 29.733,
   "text": "That band is the"
  },
  {
   "start": 29.733,
   "end": 30.913,
   "text": "one taking it."
  },
  {
   "start": 30.913,
   "end": 32.073,
   "text": "Coming down is worse"
  },
  {
   "start": 32.073,
   "end": 33.233,
   "text": "than going up."
  },
  {
   "start": 33.233,
   "end": 33.753,
   "text": "Going up,"
  },
  {
   "start": 33.753,
   "end": 35.273,
   "text": "your muscles lift you."
  },
  {
   "start": 35.273,
   "end": 36.153,
   "text": "Coming down,"
  },
  {
   "start": 36.153,
   "end": 37.193,
   "text": "you are catching yourself,"
  },
  {
   "start": 37.193,
   "end": 38.513,
   "text": "and the catch lands"
  },
  {
   "start": 38.513,
   "end": 39.643,
   "text": "on that band."
  },
  {
   "start": 39.893,
   "end": 40.633,
   "text": "That is why she"
  },
  {
   "start": 40.633,
   "end": 41.803,
   "text": "came down backwards."
  },
  {
   "start": 42.073,
   "end": 43.033,
   "text": "Backwards takes the"
  },
  {
   "start": 43.033,
   "end": 43.853,
   "text": "catch out."
  },
  {
   "start": 43.853,
   "end": 44.493,
   "text": "That is why the"
  },
  {
   "start": 44.493,
   "end": 46.373,
   "text": "chair took three tries."
  },
  {
   "start": 46.373,
   "end": 47.153,
   "text": "That is why the"
  },
  {
   "start": 47.153,
   "end": 48.193,
   "text": "good knee started going"
  },
  {
   "start": 48.193,
   "end": 49.253,
   "text": "the same way."
  },
  {
   "start": 49.253,
   "end": 50.053,
   "text": "She had been leading"
  },
  {
   "start": 50.053,
   "end": 51.283,
   "text": "with it for years."
  },
  {
   "start": 51.633,
   "end": 52.253,
   "text": "And the list of"
  },
  {
   "start": 52.253,
   "end": 52.873,
   "text": "things she said"
  },
  {
   "start": 52.873,
   "end": 53.653,
   "text": "no to got"
  },
  {
   "start": 53.653,
   "end": 55.293,
   "text": "longer every year."
  },
  {
   "start": 55.293,
   "end": 56.313,
   "text": "The long walk."
  },
  {
   "start": 56.313,
   "end": 57.053,
   "text": "The garden."
  },
  {
   "start": 57.053,
   "end": 57.873,
   "text": "Her family coming"
  },
  {
   "start": 57.873,
   "end": 58.793,
   "text": "to her instead."
  },
  {
   "start": 58.793,
   "end": 60.233,
   "text": "It was never how"
  },
  {
   "start": 60.233,
   "end": 61.333,
   "text": "hard she tried."
  },
  {
   "start": 61.333,
   "end": 61.953,
   "text": "It was never"
  },
  {
   "start": 61.953,
   "end": 63.053,
   "text": "a weak muscle."
  },
  {
   "start": 63.053,
   "end": 63.993,
   "text": "It was where the"
  },
  {
   "start": 63.993,
   "end": 65.393,
   "text": "load was landing."
  },
  {
   "start": 65.393,
   "end": 66.433,
   "text": "A sleeve squeezes"
  },
  {
   "start": 66.433,
   "end": 67.573,
   "text": "the whole knee."
  },
  {
   "start": 67.573,
   "end": 68.613,
   "text": "A hinged brace stops"
  },
  {
   "start": 68.613,
   "end": 69.453,
   "text": "it going sideways,"
  },
  {
   "start": 69.453,
   "end": 70.333,
   "text": "and her knee was"
  },
  {
   "start": 70.333,
   "end": 71.933,
   "text": "never going sideways."
  },
  {
   "start": 71.933,
   "end": 72.733,
   "text": "A gel sits"
  },
  {
   "start": 72.733,
   "end": 73.893,
   "text": "on the skin."
  },
  {
   "start": 73.893,
   "end": 74.373,
   "text": "None of them"
  },
  {
   "start": 74.373,
   "end": 75.573,
   "text": "move the load."
  },
  {
   "start": 75.573,
   "end": 76.773,
   "text": "This does."
  },
  {
   "start": 76.773,
   "end": 78.293,
   "text": "It is called Stryde."
  },
  {
   "start": 78.293,
   "end": 79.633,
   "text": "It sits two centimetres"
  },
  {
   "start": 79.633,
   "end": 80.573,
   "text": "below the kneecap,"
  },
  {
   "start": 80.573,
   "end": 81.673,
   "text": "on the tendon."
  },
  {
   "start": 81.673,
   "end": 82.633,
   "text": "It never crosses"
  },
  {
   "start": 82.633,
   "end": 83.533,
   "text": "the joint."
  },
  {
   "start": 83.533,
   "end": 84.873,
   "text": "A silicone pad inside"
  },
  {
   "start": 84.873,
   "end": 86.153,
   "text": "holds pressure on that"
  },
  {
   "start": 86.153,
   "end": 87.593,
   "text": "one band instead of"
  },
  {
   "start": 87.593,
   "end": 88.253,
   "text": "spreading it round"
  },
  {
   "start": 88.253,
   "end": 89.413,
   "text": "the whole knee."
  },
  {
   "start": 89.413,
   "end": 90.453,
   "text": "The weight gets caught"
  },
  {
   "start": 90.453,
   "end": 91.593,
   "text": "and moved off the"
  },
  {
   "start": 91.593,
   "end": 92.813,
   "text": "worn part before it"
  },
  {
   "start": 92.813,
   "end": 93.993,
   "text": "reaches the joint."
  },
  {
   "start": 93.993,
   "end": 94.893,
   "text": "The placement is"
  },
  {
   "start": 94.893,
   "end": 96.013,
   "text": "the whole thing."
  },
  {
   "start": 96.013,
   "end": 97.233,
   "text": "A centimetre too high"
  },
  {
   "start": 97.233,
   "end": 97.693,
   "text": "and it is"
  },
  {
   "start": 97.693,
   "end": 98.473,
   "text": "a sleeve again."
  },
  {
   "start": 98.473,
   "end": 99.833,
   "text": "Thirty four percent"
  },
  {
   "start": 99.833,
   "end": 101.053,
   "text": "less strain."
  },
  {
   "start": 101.053,
   "end": 101.373,
   "text": "Measured."
  },
  {
   "start": 101.373,
   "end": 102.513,
   "text": "Three years with"
  },
  {
   "start": 102.513,
   "end": 103.533,
   "text": "orthopedic surgeons."
  },
  {
   "start": 103.533,
   "end": 105.053,
   "text": "Two hundred thousand"
  },
  {
   "start": 105.053,
   "end": 105.993,
   "text": "people wearing one."
  },
  {
   "start": 105.993,
   "end": 107.093,
   "text": "Ten seconds to"
  },
  {
   "start": 107.093,
   "end": 107.753,
   "text": "put on."
  },
  {
   "start": 107.753,
   "end": 108.693,
   "text": "No sores,"
  },
  {
   "start": 108.693,
   "end": 109.713,
   "text": "no rolling down,"
  },
  {
   "start": 109.713,
   "end": 110.473,
   "text": "and nobody can"
  },
  {
   "start": 110.473,
   "end": 111.173,
   "text": "see it."
  },
  {
   "start": 111.173,
   "end": 111.833,
   "text": "I do not sell"
  },
  {
   "start": 111.833,
   "end": 112.593,
   "text": "these and I make"
  },
  {
   "start": 112.593,
   "end": 113.913,
   "text": "nothing from saying this."
  },
  {
   "start": 113.913,
   "end": 114.753,
   "text": "I say it"
  },
  {
   "start": 114.753,
   "end": 115.393,
   "text": "before we talk"
  },
  {
   "start": 115.393,
   "end": 116.373,
   "text": "about anything else,"
  },
  {
   "start": 116.373,
   "end": 117.153,
   "text": "because it is the"
  },
  {
   "start": 117.153,
   "end": 117.913,
   "text": "cheapest thing on the"
  },
  {
   "start": 117.913,
   "end": 118.613,
   "text": "list and the"
  },
  {
   "start": 118.613,
   "end": 119.513,
   "text": "only one aimed"
  },
  {
   "start": 119.513,
   "end": 120.473,
   "text": "at the band."
  },
  {
   "start": 120.473,
   "end": 121.133,
   "text": "You do not have"
  },
  {
   "start": 121.133,
   "end": 121.713,
   "text": "to take my"
  },
  {
   "start": 121.713,
   "end": 122.833,
   "text": "word for it."
  },
  {
   "start": 122.833,
   "end": 124.013,
   "text": "One knee only."
  },
  {
   "start": 124.013,
   "end": 125.193,
   "text": "Leave the other bare."
  },
  {
   "start": 125.193,
   "end": 125.633,
   "text": "Go to your"
  },
  {
   "start": 125.633,
   "end": 126.453,
   "text": "own stairs and"
  },
  {
   "start": 126.453,
   "end": 127.793,
   "text": "come down forwards."
  },
  {
   "start": 127.793,
   "end": 128.313,
   "text": "You will know"
  },
  {
   "start": 128.313,
   "end": 129.213,
   "text": "in a minute."
  },
  {
   "start": 129.213,
   "end": 129.993,
   "text": "Not because the"
  },
  {
   "start": 129.993,
   "end": 131.413,
   "text": "arthritis has gone."
  },
  {
   "start": 131.413,
   "end": 132.713,
   "text": "Her scan looks exactly"
  },
  {
   "start": 132.713,
   "end": 133.373,
   "text": "the same as it"
  },
  {
   "start": 133.373,
   "end": 134.413,
   "text": "did in March."
  },
  {
   "start": 134.413,
   "end": 135.073,
   "text": "I have both"
  },
  {
   "start": 135.073,
   "end": 135.813,
   "text": "of them."
  },
  {
   "start": 135.813,
   "end": 136.773,
   "text": "Because the load is"
  },
  {
   "start": 136.773,
   "end": 137.853,
   "text": "not landing on that"
  },
  {
   "start": 137.853,
   "end": 138.953,
   "text": "band any more."
  },
  {
   "start": 138.953,
   "end": 140.333,
   "text": "You cannot strengthen your"
  },
  {
   "start": 140.333,
   "end": 140.813,
   "text": "way out of"
  },
  {
   "start": 140.813,
   "end": 141.873,
   "text": "a load problem."
  },
  {
   "start": 141.873,
   "end": 142.653,
   "text": "You have to"
  },
  {
   "start": 142.653,
   "end": 143.513,
   "text": "move the load."
  },
  {
   "start": 143.513,
   "end": 144.733,
   "text": "Two for one,"
  },
  {
   "start": 144.733,
   "end": 145.073,
   "text": "so you do"
  },
  {
   "start": 145.073,
   "end": 145.713,
   "text": "both knees,"
  },
  {
   "start": 145.713,
   "end": 146.273,
   "text": "which is what"
  },
  {
   "start": 146.273,
   "end": 146.793,
   "text": "she needed."
  },
  {
   "start": 146.793,
   "end": 147.813,
   "text": "Sixty days,"
  },
  {
   "start": 147.813,
   "end": 148.553,
   "text": "and you keep"
  },
  {
   "start": 148.553,
   "end": 149.533,
   "text": "the straps."
  },
  {
   "start": 149.533,
   "end": 150.793,
   "text": "From the Stryde site."
  },
  {
   "start": 150.793,
   "end": 151.593,
   "text": "The copies stretch,"
  },
  {
   "start": 151.593,
   "end": 152.993,
   "text": "and a stretched strap"
  },
  {
   "start": 152.993,
   "end": 154.793,
   "text": "stops holding the spot."
  },
  {
   "start": 154.793,
   "end": 155.453,
   "text": "Nothing to lose"
  },
  {
   "start": 155.453,
   "end": 156.493,
   "text": "but the pain."
  },
  {
   "start": 156.493,
   "end": 156.853,
   "text": "Go and do"
  },
  {
   "start": 156.853,
   "end": 157.693,
   "text": "your stairs."
  }
 ]
}