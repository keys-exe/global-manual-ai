{
 "cards": [
  {
   "start": 0.0,
   "end": 1.6,
   "text": "Every week somebody brings"
  },
  {
   "start": 1.6,
   "end": 2.36,
   "text": "me a scan of"
  },
  {
   "start": 2.36,
   "end": 3.3,
   "text": "a knee and asks"
  },
  {
   "start": 3.3,
   "end": 4.08,
   "text": "what can be done"
  },
  {
   "start": 4.08,
   "end": 5.44,
   "text": "about the cartilage."
  },
  {
   "start": 5.44,
   "end": 6.52,
   "text": "I have started answering"
  },
  {
   "start": 6.52,
   "end": 7.625,
   "text": "a different question."
  },
  {
   "start": 7.625,
   "end": 9.005,
   "text": "A patient of mine."
  },
  {
   "start": 9.005,
   "end": 10.305,
   "text": "Nine years of"
  },
  {
   "start": 10.305,
   "end": 11.145,
   "text": "knee pain."
  },
  {
   "start": 11.145,
   "end": 11.665,
   "text": "Bone on bone"
  },
  {
   "start": 11.665,
   "end": 12.525,
   "text": "on the left,"
  },
  {
   "start": 12.525,
   "end": 13.065,
   "text": "the right one"
  },
  {
   "start": 13.065,
   "end": 14.145,
   "text": "following it."
  },
  {
   "start": 14.145,
   "end": 14.585,
   "text": "Here is what"
  },
  {
   "start": 14.585,
   "end": 15.345,
   "text": "her scan does"
  },
  {
   "start": 15.345,
   "end": 16.345,
   "text": "not show you."
  },
  {
   "start": 16.345,
   "end": 18.105,
   "text": "Two centimetres below your"
  },
  {
   "start": 18.105,
   "end": 19.085,
   "text": "kneecap there is a"
  },
  {
   "start": 19.085,
   "end": 19.845,
   "text": "band of tendon"
  },
  {
   "start": 19.845,
   "end": 20.725,
   "text": "about as wide"
  },
  {
   "start": 20.725,
   "end": 21.845,
   "text": "as your thumb."
  },
  {
   "start": 21.845,
   "end": 23.025,
   "text": "Every step you take"
  },
  {
   "start": 23.025,
   "end": 23.945,
   "text": "lands on it."
  },
  {
   "start": 23.945,
   "end": 26.425,
   "text": "Seventeen times your bodyweight."
  },
  {
   "start": 26.425,
   "end": 27.245,
   "text": "Put your finger under"
  },
  {
   "start": 27.245,
   "end": 28.805,
   "text": "your kneecap and press."
  },
  {
   "start": 28.805,
   "end": 29.905,
   "text": "That band is the"
  },
  {
   "start": 29.905,
   "end": 31.065,
   "text": "one taking it."
  },
  {
   "start": 31.065,
   "end": 32.225,
   "text": "Coming down is worse"
  },
  {
   "start": 32.225,
   "end": 33.385,
   "text": "than going up."
  },
  {
   "start": 33.385,
   "end": 34.085,
   "text": "Going up,"
  },
  {
   "start": 34.085,
   "end": 35.405,
   "text": "your muscles lift you."
  },
  {
   "start": 35.405,
   "end": 36.045,
   "text": "Coming down,"
  },
  {
   "start": 36.045,
   "end": 37.365,
   "text": "you are catching yourself,"
  },
  {
   "start": 37.365,
   "end": 38.705,
   "text": "and the catch lands"
  },
  {
   "start": 38.705,
   "end": 39.905,
   "text": "on that band."
  },
  {
   "start": 39.905,
   "end": 40.605,
   "text": "That is why she"
  },
  {
   "start": 40.605,
   "end": 41.775,
   "text": "came down backwards."
  },
  {
   "start": 42.045,
   "end": 43.005,
   "text": "Backwards takes the"
  },
  {
   "start": 43.005,
   "end": 43.845,
   "text": "catch out."
  },
  {
   "start": 43.845,
   "end": 44.485,
   "text": "That is why the"
  },
  {
   "start": 44.485,
   "end": 46.285,
   "text": "chair took three tries."
  },
  {
   "start": 46.285,
   "end": 47.125,
   "text": "That is why the"
  },
  {
   "start": 47.125,
   "end": 48.165,
   "text": "good knee started going"
  },
  {
   "start": 48.165,
   "end": 49.205,
   "text": "the same way."
  },
  {
   "start": 49.205,
   "end": 50.005,
   "text": "She had been leading"
  },
  {
   "start": 50.005,
   "end": 51.405,
   "text": "with it for years."
  },
  {
   "start": 51.405,
   "end": 52.065,
   "text": "And the list of"
  },
  {
   "start": 52.065,
   "end": 52.685,
   "text": "things she said"
  },
  {
   "start": 52.685,
   "end": 53.465,
   "text": "no to got"
  },
  {
   "start": 53.465,
   "end": 55.105,
   "text": "longer every year."
  },
  {
   "start": 55.105,
   "end": 56.145,
   "text": "The long walk."
  },
  {
   "start": 56.145,
   "end": 56.865,
   "text": "The garden."
  },
  {
   "start": 56.865,
   "end": 57.685,
   "text": "Her family coming"
  },
  {
   "start": 57.685,
   "end": 58.925,
   "text": "to her instead."
  },
  {
   "start": 58.925,
   "end": 59.905,
   "text": "It was never how"
  },
  {
   "start": 59.905,
   "end": 60.965,
   "text": "hard she tried."
  },
  {
   "start": 60.965,
   "end": 61.625,
   "text": "It was never"
  },
  {
   "start": 61.625,
   "end": 62.645,
   "text": "a weak muscle."
  },
  {
   "start": 62.645,
   "end": 63.685,
   "text": "It was where the"
  },
  {
   "start": 63.685,
   "end": 64.605,
   "text": "load was landing."
  },
  {
   "start": 64.605,
   "end": 65.985,
   "text": "A sleeve squeezes"
  },
  {
   "start": 65.985,
   "end": 67.105,
   "text": "the whole knee."
  },
  {
   "start": 67.105,
   "end": 68.165,
   "text": "A hinged brace stops"
  },
  {
   "start": 68.165,
   "end": 69.205,
   "text": "it going sideways,"
  },
  {
   "start": 69.205,
   "end": 69.745,
   "text": "and her knee was"
  },
  {
   "start": 69.745,
   "end": 71.225,
   "text": "never going sideways."
  },
  {
   "start": 71.225,
   "end": 72.045,
   "text": "A gel sits"
  },
  {
   "start": 72.045,
   "end": 73.185,
   "text": "on the skin."
  },
  {
   "start": 73.185,
   "end": 73.645,
   "text": "None of them"
  },
  {
   "start": 73.645,
   "end": 74.885,
   "text": "move the load."
  },
  {
   "start": 74.885,
   "end": 76.045,
   "text": "This does."
  },
  {
   "start": 76.045,
   "end": 77.485,
   "text": "It is called Stryde."
  },
  {
   "start": 77.485,
   "end": 78.665,
   "text": "It sits two centimetres"
  },
  {
   "start": 78.665,
   "end": 79.765,
   "text": "below the kneecap,"
  },
  {
   "start": 79.765,
   "end": 80.845,
   "text": "on the tendon."
  },
  {
   "start": 80.845,
   "end": 81.805,
   "text": "It never crosses"
  },
  {
   "start": 81.805,
   "end": 82.725,
   "text": "the joint."
  },
  {
   "start": 82.725,
   "end": 84.045,
   "text": "A silicone pad inside"
  },
  {
   "start": 84.045,
   "end": 85.325,
   "text": "holds pressure on that"
  },
  {
   "start": 85.325,
   "end": 86.765,
   "text": "one band instead of"
  },
  {
   "start": 86.765,
   "end": 87.425,
   "text": "spreading it round"
  },
  {
   "start": 87.425,
   "end": 88.545,
   "text": "the whole knee."
  },
  {
   "start": 88.545,
   "end": 89.605,
   "text": "The weight gets caught"
  },
  {
   "start": 89.605,
   "end": 90.785,
   "text": "and moved off the"
  },
  {
   "start": 90.785,
   "end": 91.985,
   "text": "worn part before it"
  },
  {
   "start": 91.985,
   "end": 93.185,
   "text": "reaches the joint."
  },
  {
   "start": 93.185,
   "end": 94.105,
   "text": "The placement is"
  },
  {
   "start": 94.105,
   "end": 95.185,
   "text": "the whole thing."
  },
  {
   "start": 95.185,
   "end": 96.425,
   "text": "A centimetre too high"
  },
  {
   "start": 96.425,
   "end": 96.885,
   "text": "and it is"
  },
  {
   "start": 96.885,
   "end": 97.645,
   "text": "a sleeve again."
  },
  {
   "start": 97.645,
   "end": 98.825,
   "text": "Thirty four percent"
  },
  {
   "start": 98.825,
   "end": 100.105,
   "text": "less strain."
  },
  {
   "start": 100.105,
   "end": 100.445,
   "text": "Measured."
  },
  {
   "start": 100.445,
   "end": 101.585,
   "text": "Three years with"
  },
  {
   "start": 101.585,
   "end": 102.577,
   "text": "orthopedic surgeons."
  },
  {
   "start": 102.577,
   "end": 104.065,
   "text": "Two hundred thousand"
  },
  {
   "start": 104.065,
   "end": 104.985,
   "text": "people wearing one."
  },
  {
   "start": 104.985,
   "end": 106.085,
   "text": "Ten seconds to"
  },
  {
   "start": 106.085,
   "end": 106.745,
   "text": "put on."
  },
  {
   "start": 106.745,
   "end": 107.685,
   "text": "No sores,"
  },
  {
   "start": 107.685,
   "end": 108.705,
   "text": "no rolling down,"
  },
  {
   "start": 108.705,
   "end": 109.445,
   "text": "and nobody can"
  },
  {
   "start": 109.445,
   "end": 110.125,
   "text": "see it."
  },
  {
   "start": 110.125,
   "end": 110.805,
   "text": "I do not sell"
  },
  {
   "start": 110.805,
   "end": 111.565,
   "text": "these and I make"
  },
  {
   "start": 111.565,
   "end": 113.125,
   "text": "nothing from saying this."
  },
  {
   "start": 113.125,
   "end": 113.725,
   "text": "I say it"
  },
  {
   "start": 113.725,
   "end": 114.385,
   "text": "before we talk"
  },
  {
   "start": 114.385,
   "end": 115.365,
   "text": "about anything else,"
  },
  {
   "start": 115.365,
   "end": 116.125,
   "text": "because it is the"
  },
  {
   "start": 116.125,
   "end": 116.885,
   "text": "cheapest thing on the"
  },
  {
   "start": 116.885,
   "end": 117.605,
   "text": "list and the"
  },
  {
   "start": 117.605,
   "end": 118.465,
   "text": "only one aimed"
  },
  {
   "start": 118.465,
   "end": 119.085,
   "text": "at the band."
  },
  {
   "start": 119.085,
   "end": 120.125,
   "text": "You do not have"
  },
  {
   "start": 120.125,
   "end": 120.705,
   "text": "to take my"
  },
  {
   "start": 120.705,
   "end": 121.845,
   "text": "word for it."
  },
  {
   "start": 121.845,
   "end": 122.905,
   "text": "One knee only."
  },
  {
   "start": 122.905,
   "end": 124.025,
   "text": "Leave the other bare."
  },
  {
   "start": 124.025,
   "end": 124.465,
   "text": "Go to your"
  },
  {
   "start": 124.465,
   "end": 125.265,
   "text": "own stairs and"
  },
  {
   "start": 125.265,
   "end": 126.665,
   "text": "come down forwards."
  },
  {
   "start": 126.665,
   "end": 127.145,
   "text": "You will know"
  },
  {
   "start": 127.145,
   "end": 127.915,
   "text": "in a minute."
  },
  {
   "start": 128.165,
   "end": 128.805,
   "text": "Not because the"
  },
  {
   "start": 128.805,
   "end": 130.225,
   "text": "arthritis has gone."
  },
  {
   "start": 130.225,
   "end": 131.525,
   "text": "Her scan looks exactly"
  },
  {
   "start": 131.525,
   "end": 132.185,
   "text": "the same as it"
  },
  {
   "start": 132.185,
   "end": 133.265,
   "text": "did in March."
  },
  {
   "start": 133.265,
   "end": 133.825,
   "text": "I have both"
  },
  {
   "start": 133.825,
   "end": 134.605,
   "text": "of them."
  },
  {
   "start": 134.605,
   "end": 135.525,
   "text": "Because the load is"
  },
  {
   "start": 135.525,
   "end": 136.625,
   "text": "not landing on that"
  },
  {
   "start": 136.625,
   "end": 137.705,
   "text": "band any more."
  },
  {
   "start": 137.705,
   "end": 139.045,
   "text": "You cannot strengthen your"
  },
  {
   "start": 139.045,
   "end": 139.525,
   "text": "way out of"
  },
  {
   "start": 139.525,
   "end": 140.625,
   "text": "a load problem."
  },
  {
   "start": 140.625,
   "end": 141.365,
   "text": "You have to"
  },
  {
   "start": 141.365,
   "end": 142.605,
   "text": "move the load."
  },
  {
   "start": 142.605,
   "end": 143.405,
   "text": "Two for one,"
  },
  {
   "start": 143.405,
   "end": 143.785,
   "text": "so you do"
  },
  {
   "start": 143.785,
   "end": 144.565,
   "text": "both knees,"
  },
  {
   "start": 144.565,
   "end": 144.965,
   "text": "which is what"
  },
  {
   "start": 144.965,
   "end": 145.485,
   "text": "she needed."
  },
  {
   "start": 145.485,
   "end": 146.445,
   "text": "Sixty days,"
  },
  {
   "start": 146.445,
   "end": 147.185,
   "text": "and you keep"
  },
  {
   "start": 147.185,
   "end": 148.165,
   "text": "the straps."
  },
  {
   "start": 148.165,
   "end": 149.405,
   "text": "From the Stryde site."
  },
  {
   "start": 149.405,
   "end": 150.225,
   "text": "The copies stretch,"
  },
  {
   "start": 150.225,
   "end": 151.605,
   "text": "and a stretched strap"
  },
  {
   "start": 151.605,
   "end": 153.445,
   "text": "stops holding the spot."
  },
  {
   "start": 153.445,
   "end": 154.065,
   "text": "Nothing to lose"
  },
  {
   "start": 154.065,
   "end": 155.085,
   "text": "but the pain."
  },
  {
   "start": 155.085,
   "end": 155.425,
   "text": "Go and do"
  },
  {
   "start": 155.425,
   "end": 156.185,
   "text": "your stairs."
  }
 ]
}