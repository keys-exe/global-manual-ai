      "clip": "/tmp/claude-0/-home-user-global-manual-ai/10717553-fbf6-591d-840c-948130683a36/scratchpad/media/BR-035.mp4",
      "phrase": "So you do not wrap the joint.",
      "key": "wrap",
      "layout": {
        "type": "full"
      },
      "word_t": 96.36,
      "start": 96.25,
      "line_end": 96.9583,
