    },
    {
      "beat": "MECH-036",
      "clip": "/tmp/claude-0/-home-user-global-manual-ai/10717553-fbf6-591d-840c-948130683a36/scratchpad/media/MECH-036.mp4",
      "phrase": "You go underneath it.",
      "key": "underneath",
      "layout": {
        "type": "full"
      },
      "word_t": 96.32,
      "start": 97.0417,
      "line_end": 96.9583,
      "in_spec": null,
