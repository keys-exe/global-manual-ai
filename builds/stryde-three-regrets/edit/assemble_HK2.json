      "clip": "/tmp/claude-0/-home-user-global-manual-ai/10717553-fbf6-591d-840c-948130683a36/scratchpad/media/BR-046.mp4",
      "phrase": "Two hundred thousand people wearing one.",
      "key": "Two",
      "layout": {
        "type": "full"
      },
