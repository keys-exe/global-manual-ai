      "phrase": "So you do not wrap the joint.",
      "key": "wrap",
      "layout": {
        "type": "full"
      },
      "word_t": 95.16,
      "start": 95.0417,
      "line_end": 95.7917,
      "in_spec": null,
      "peak": null,
      "max": 6.0,
