      "clip": "/tmp/claude-0/-home-user-global-manual-ai/10717553-fbf6-591d-840c-948130683a36/scratchpad/media/BR-048.mp4",
      "phrase": "No sores, no rolling down, and nobody can see it.",
      "key": "nobody",
      "layout": {
        "type": "full"
      },
