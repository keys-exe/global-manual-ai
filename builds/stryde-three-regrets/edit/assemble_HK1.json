      "clip": "/tmp/claude-0/-home-user-global-manual-ai/10717553-fbf6-591d-840c-948130683a36/scratchpad/media/BR-035.mp4",
      "phrase": "So you do not wrap the joint.",
      "key": "wrap",
      "layout": {
        "type": "full"
      },
      "word_t": 94.06,
      "start": 93.9583,
      "line_end": 94.6667,
      "in_spec": null,
      "peak": null,
      "max": 6.0,
      "clip_len": 3.04,
      "speed": 1.0,
      "in": 0.4,
      "flex": true,
      "skip": 0.4,
      "end": 95.9583
    },
    {
      "beat": "MECH-036",
      "clip": "/tmp/claude-0/-home-user-global-manual-ai/10717553-fbf6-591d-840c-948130683a36/scratchpad/media/MECH-036.mp4",
      "phrase": "You go underneath it.",
      "key": "underneath",
      "layout": {
        "type": "full"
      },
      "word_t": 95.2,
      "start": 95.9583,
      "line_end": 95.8333,
      "in_spec": null,
      "peak": null,
      "max": 6.0,
      "clip_len": 3.04,
      "speed": 1.0,
      "in": 0.4,
      "flex": true,
      "skip": 0.4,
      "end": 97.9583
    },
    {
      "beat": "PR-037",
      "clip": "/tmp/claude-0/-home-user-global-manual-ai/10717553-fbf6-591d-840c-948130683a36/scratchpad/media/PR-037.mp4",
      "phrase": "This one is called Stryde.",
      "key": "Stryde.",
      "layout": {
        "type": "full"
      },
      "word_t": 96.62,
      "start": 97.9583,
      "line_end": 97.4167,
      "in_spec": null,
      "peak": null,
      "max": 6.0,
      "clip_len": 4.04,
      "speed": 1.0,
      "in": 0.4,
      "flex": true,
      "skip": 0.4,
      "end": 99.9583
    },
    {
      "beat": "BR-038",
      "clip": "/tmp/claude-0/-home-user-global-manual-ai/10717553-fbf6-591d-840c-948130683a36/scratchpad/media/BR-038.mp4",
      "phrase": "It sits two centimetres below the kneecap, on the tendon, and never crosses the joint.",
      "key": "below",
      "layout": {
        "type": "full"
      },
      "word_t": 98.44,
      "start": 99.9583,
      "line_end": 101.625,
      "in_spec": null,
      "peak": null,
      "max": 6.0,
      "clip_len": 5.04,
      "speed": 1.0,
      "in": 0.4,
      "flex": true,
      "skip": 0.4,
      "end": 102.2083
    },
    {
      "beat": "BR-039",
      "clip": "/tmp/claude-0/-home-user-global-manual-ai/10717553-fbf6-591d-840c-948130683a36/scratchpad/media/BR-039.mp4",
      "phrase": "A silicone pad inside holds pressure on that one band instead of spreading it round the whole knee.",
      "key": "pad",
      "layout": {
        "type": "full"
      },
      "word_t": 102.32,
      "start": 102.2083,
      "line_end": 107.0,
      "in_spec": null,
      "peak": null,
      "max": 6.0,
      "clip_len": 6.04,
      "speed": 1.0,
      "in": 0.4,
      "flex": true,
      "skip": 0.4,
      "end": 107.5833
    },
    {
      "beat": "MECH-040",
      "clip": "/tmp/claude-0/-home-user-global-manual-ai/10717553-fbf6-591d-840c-948130683a36/scratchpad/media/MECH-040.mp4",
      "phrase": "The weight gets caught and moved off the worn part before it reaches the joint.",
      "key": "caught",
      "layout": {
        "type": "full"
      },
      "word_t": 107.7,
      "start": 107.5833,
      "line_end": 110.8333,
      "in_spec": null,
      "peak": null,
      "max": 6.0,
      "clip_len": 5.04,
      "speed": 1.0,
      "in": 0.4,
      "flex": true,
      "skip": 0.4,
      "end": 111.125
    },
    {
      "beat": "BR-041",
      "clip": "/tmp/claude-0/-home-user-global-manual-ai/10717553-fbf6-591d-840c-948130683a36/scratchpad/media/BR-041.mp4",
      "phrase": "The placement is the whole thing.",
      "key": "placement",
      "layout": {
        "type": "full"
      },
      "word_t": 111.22,
      "start": 111.125,
      "line_end": 112.375,
      "in_spec": null,
      "peak": null,
      "max": 6.0,
      "clip_len": 3.04,
      "speed": 1.0,
      "in": 0.4,
      "flex": true,
      "skip": 0.4,
      "end": 113.125
    },
    {
      "beat": "BR-042",
      "clip": "/tmp/claude-0/-home-user-global-manual-ai/10717553-fbf6-591d-840c-948130683a36/scratchpad/media/BR-042.mp4",
      "phrase": "A centimetre too high and it is a sleeve again.",
      "key": "centimetre",
      "layout": {
        "type": "full"
      },
      "word_t": 112.64,
      "start": 113.125,
      "line_end": 114.9583,
      "in_spec": null,
      "peak": null,
      "max": 6.0,
      "clip_len": 4.04,
      "speed": 1.0,
      "in": 0.4,
      "flex": true,
      "skip": 0.4,
      "end": 115.125
    },
    {
      "beat": "BR-043",
      "clip": "/tmp/claude-0/-home-user-global-manual-ai/10717553-fbf6-591d-840c-948130683a36/scratchpad/media/BR-043.mp4",
      "phrase": "Thirty four percent less strain. Measured.",
      "key": "Thirty",
      "layout": {
        "type": "full"
      },
      "word_t": 114.96,
      "start": 115.125,
      "line_end": 117.3333,
      "in_spec": null,
      "peak": null,
      "max": 6.0,
      "clip_len": 5.04,
      "speed": 1.0,
      "in": 0.4,
      "flex": true,
      "skip": 0.4,
      "end": 118.125
    },
    {
      "beat": "PR-045",
      "clip": "/tmp/claude-0/-home-user-global-manual-ai/10717553-fbf6-591d-840c-948130683a36/scratchpad/media/PR-045.mp4",
      "phrase": "Three years with orthopedic surgeons.",
      "key": "orthopedic",
      "layout": {
        "type": "full"
      },
      "word_t": 118.22,
      "start": 118.125,
      "line_end": 119.0833,
      "in_spec": null,
      "peak": null,
      "max": 6.0,
      "clip_len": 3.04,
      "speed": 1.0,
      "in": 0.4,
