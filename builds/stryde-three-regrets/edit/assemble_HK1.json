      "clip": "/tmp/claude-0/-home-user-global-manual-ai/10717553-fbf6-591d-840c-948130683a36/scratchpad/media/BR-058.mp4",
      "phrase": "I wish somebody had told me this four years ago.",
      "key": "wish",
