    },
    {
      "beat": "BR-053",
      "clip": "/tmp/claude-0/-home-user-global-manual-ai/10717553-fbf6-591d-840c-948130683a36/scratchpad/media/BR-053.mp4",
      "phrase": "You will know in a minute.",
      "key": "know",
      "layout": {
        "type": "full"
      },
      "word_t": 132.92,
