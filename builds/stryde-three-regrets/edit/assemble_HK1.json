      "skip": 0.4,
      "end": 128.2917
    },
    {
      "beat": "BR-050",
      "clip": "/tmp/claude-0/-home-user-global-manual-ai/10717553-fbf6-591d-840c-948130683a36/scratchpad/media/BR-050.mp4",
      "phrase": "One knee only. Leave the other bare.",
      "key": "One",
      "layout": {
        "type": "full"
      },
