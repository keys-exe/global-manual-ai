      "end": 131.4167
    },
    {
      "beat": "BR-052",
      "clip": "/tmp/claude-0/-home-user-global-manual-ai/10717553-fbf6-591d-840c-948130683a36/scratchpad/media/BR-052.mp4",
      "phrase": "Go to your own stairs and come down forwards.",
      "key": "come",
      "layout": {
        "type": "full"
      },
      "word_t": 131.5,
