    },
    {
      "beat": "BR-047",
      "clip": "/tmp/claude-0/-home-user-global-manual-ai/10717553-fbf6-591d-840c-948130683a36/scratchpad/media/BR-047.mp4",
      "phrase": "Ten seconds to put on.",
      "key": "Ten",
      "layout": {
        "type": "full"
      },
      "word_t": 121.36,
      "start": 122.125,
      "line_end": 122.6667,
