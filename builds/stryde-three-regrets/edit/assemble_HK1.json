    },
    {
      "beat": "PR-062",
      "clip": "/tmp/claude-0/-home-user-global-manual-ai/10717553-fbf6-591d-840c-948130683a36/scratchpad/media/PR-062.mp4",
      "phrase": "Sixty days, and you keep the straps.",
