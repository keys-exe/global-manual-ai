      "clip": "/tmp/claude-0/-home-user-global-manual-ai/10717553-fbf6-591d-840c-948130683a36/scratchpad/media/BR-057.mp4",
      "phrase": "Most of those messages end the same way.",
      "key": "messages",
      "layout": {
        "type": "full"
      },
