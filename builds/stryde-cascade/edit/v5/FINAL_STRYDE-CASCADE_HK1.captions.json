  {
   "start": 86.352,
   "end": 87.942,
   "text": "band carrying everything."
  },
  {
   "start": 88.212,
   "end": 88.592,
   "text": "None of them"
  },
  {
   "start": 88.592,
   "end": 89.492,
   "text": "are wrong."
  },
  {
   "start": 89.492,
   "end": 90.012,
   "text": "None of them"
  },
  {
   "start": 90.012,
   "end": 90.732,
   "text": "move the weight"
  },
  {
   "start": 90.732,
   "end": 91.712,
   "text": "off the band,"
  },
  {
   "start": 91.712,
   "end": 92.432,
   "text": "and that is"
  },
  {
   "start": 92.432,
   "end": 93.212,
   "text": "the only thing"
  },
  {
   "start": 93.212,
   "end": 93.912,
   "text": "that stops the"
  },
  {
   "start": 93.912,
   "end": 94.482,
   "text": "sequence."
  },
  {
   "start": 94.812,
   "end": 95.372,
   "text": "The strap I"
  },
  {
   "start": 95.372,
   "end": 95.812,
   "text": "keep in the"
  },
  {
   "start": 95.812,
   "end": 96.452,
   "text": "van now is"
  },
  {
   "start": 96.452,
   "end": 97.652,
   "text": "called Stryde."
  },
  {
   "start": 97.652,
   "end": 98.352,
   "text": "It sits two"
  },
  {
   "start": 98.352,
   "end": 99.452,
   "text": "centimetres below the"
  },
  {
   "start": 99.452,
   "end": 99.872,
   "text": "kneecap,"
  },
  {
   "start": 99.872,
   "end": 100.572,
   "text": "on the tendon."
  },
  {
   "start": 100.572,
   "end": 101.852,
   "text": "It never crosses"
  },
  {
   "start": 101.852,
   "end": 102.732,
   "text": "the joint."
  },
  {
   "start": 102.732,
   "end": 103.112,
   "text": "There is a"
  },
  {
   "start": 103.112,
   "end": 104.212,
   "text": "silicone pad inside"
  },
  {
   "start": 104.212,
   "end": 105.152,
   "text": "that holds pressure"
  },
  {
   "start": 105.152,
   "end": 105.812,
   "text": "on that one"
  },
  {
   "start": 105.812,
   "end": 106.872,
   "text": "band instead of"
