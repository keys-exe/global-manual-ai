  {
   "start": 42.178,
   "end": 42.778,
   "text": "one place."
  },
  {
   "start": 42.778,
   "end": 44.158,
   "text": "Two centimetres below"
  },
  {
   "start": 44.158,
   "end": 45.138,
   "text": "your kneecap there"
  },
  {
   "start": 45.138,
   "end": 45.538,
   "text": "is a band"
  },
  {
   "start": 45.538,
   "end": 46.378,
   "text": "of tendon about"
  },
  {
   "start": 46.378,
   "end": 46.978,
   "text": "as wide as"
  },
  {
   "start": 46.978,
   "end": 47.798,
   "text": "your thumb."
  },
  {
   "start": 47.798,
   "end": 48.498,
   "text": "Every step you"
  },
  {
   "start": 48.498,
   "end": 49.498,
   "text": "take lands on"
  },
  {
   "start": 49.498,
   "end": 49.658,
   "text": "it."
  },
  {
   "start": 49.658,
   "end": 51.398,
   "text": "Seventeen times your"
