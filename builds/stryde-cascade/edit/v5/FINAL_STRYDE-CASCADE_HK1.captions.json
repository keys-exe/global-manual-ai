   "start": 75.138,
   "end": 75.958,
   "text": "part of it."
  },
  {
   "start": 75.958,
   "end": 76.558,
   "text": "It has never"
  },
  {
   "start": 76.558,
   "end": 77.078,
   "text": "been the whole"
  },
  {
   "start": 77.078,
   "end": 77.738,
   "text": "of it."
  },
  {
   "start": 77.738,
   "end": 78.598,
   "text": "The physio helps"
  },
  {
   "start": 78.598,
   "end": 79.518,
   "text": "and then stops"
  },
  {
   "start": 79.518,
   "end": 80.318,
   "text": "helping."
  },
  {
   "start": 80.318,
   "end": 81.098,
   "text": "The gel sits"
  },
  {
   "start": 81.098,
   "end": 82.098,
   "text": "on your skin."
  },
  {
   "start": 82.098,
   "end": 82.938,
   "text": "The pills switch"
