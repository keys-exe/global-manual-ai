  },
  {
   "start": 97.538,
   "end": 98.518,
   "text": "It sits two"
  },
  {
   "start": 98.518,
   "end": 99.518,
   "text": "centimetres below the"
  },
  {
   "start": 99.518,
   "end": 99.978,
   "text": "kneecap,"
  },
  {
   "start": 99.978,
   "end": 101.118,
   "text": "on the tendon."
  },
  {
   "start": 101.118,
   "end": 102.098,
   "text": "It never crosses"
  },
  {
   "start": 102.098,
   "end": 102.868,
   "text": "the joint."
  },
  {
   "start": 103.158,
   "end": 103.538,
   "text": "There is a"
  },
  {
   "start": 103.538,
   "end": 104.658,
   "text": "silicone pad inside"
  },
  {
   "start": 104.658,
   "end": 105.618,
   "text": "that holds pressure"
  },
  {
   "start": 105.618,
   "end": 106.298,
   "text": "on that one"
  },
  {
   "start": 106.298,
   "end": 107.398,
   "text": "band instead of"
  },
  {
