   "start": 149.552,
   "end": 150.472,
   "text": "in a minute."
  },
  {
   "start": 150.472,
   "end": 151.192,
   "text": "Two for one,"
  },
  {
   "start": 151.192,
   "end": 151.552,
   "text": "so you do"
