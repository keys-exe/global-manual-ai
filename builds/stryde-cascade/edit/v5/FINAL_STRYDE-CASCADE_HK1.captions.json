   "start": 75.078,
   "end": 75.938,
   "text": "part of it."
  },
  {
   "start": 75.938,
   "end": 76.458,
   "text": "It has never"
  },
  {
   "start": 76.458,
   "end": 77.018,
   "text": "been the whole"
  },
  {
   "start": 77.018,
   "end": 77.698,
   "text": "of it."
  },
  {
   "start": 77.698,
   "end": 78.418,
   "text": "The physio helps"
  },
  {
   "start": 78.418,
   "end": 79.358,
   "text": "and then stops"
  },
  {
   "start": 79.358,
   "end": 79.988,
   "text": "helping."
  },
  {
   "start": 80.278,
   "end": 80.978,
   "text": "The gel sits"
  },
  {
   "start": 80.978,
   "end": 81.828,
   "text": "on your skin."
  },
  {
   "start": 82.098,
   "end": 82.838,
   "text": "The pills switch"
