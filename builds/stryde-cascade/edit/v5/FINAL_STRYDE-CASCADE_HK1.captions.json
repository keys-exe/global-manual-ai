   "start": 74.892,
   "end": 75.692,
   "text": "part of it."
  },
  {
   "start": 75.692,
   "end": 76.292,
   "text": "It has never"
  },
  {
   "start": 76.292,
   "end": 76.832,
   "text": "been the whole"
  },
  {
   "start": 76.832,
   "end": 77.552,
   "text": "of it."
  },
  {
   "start": 77.552,
   "end": 78.652,
   "text": "The physio helps"
  },
  {
   "start": 78.652,
   "end": 79.312,
   "text": "and then stops"
  },
  {
   "start": 79.312,
   "end": 80.072,
   "text": "helping."
  },
  {
   "start": 80.072,
   "end": 80.872,
   "text": "The gel sits"
  },
  {
   "start": 80.872,
   "end": 81.852,
   "text": "on your skin."
  },
  {
   "start": 81.852,
   "end": 82.732,
   "text": "The pills switch"
  },
  {
   "start": 82.732,
   "end": 83.772,
   "text": "the alarm off."
  },
  {
   "start": 83.772,
   "end": 84.772,
   "text": "The sleeve squeezes"
