   "end": 90.898,
   "text": "move the weight"
  },
  {
   "start": 90.898,
   "end": 92.058,
   "text": "off the band,"
  },
  {
   "start": 92.058,
   "end": 92.638,
   "text": "and that is"
  },
  {
   "start": 92.638,
   "end": 93.458,
   "text": "the only thing"
  },
  {
   "start": 93.458,
   "end": 94.138,
   "text": "that stops the"
  },
  {
   "start": 94.138,
   "end": 94.418,
   "text": "sequence."
  },
  {
   "start": 94.418,
   "end": 95.578,
   "text": "The strap I"
  },
  {
   "start": 95.578,
   "end": 95.978,
   "text": "keep in the"
  },
  {
   "start": 95.978,
   "end": 96.638,
   "text": "van now is"
  },
