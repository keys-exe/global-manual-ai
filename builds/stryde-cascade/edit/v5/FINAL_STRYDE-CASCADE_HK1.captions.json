   "start": 59.158,
   "end": 59.798,
   "text": "you."
  },
  {
   "start": 59.798,
   "end": 60.678,
   "text": "Coming down,"
  },
  {
   "start": 60.678,
   "end": 61.818,
   "text": "nothing does."
  },
  {
   "start": 61.818,
   "end": 62.318,
   "text": "You are catching"
  },
  {
   "start": 62.318,
   "end": 62.718,
   "text": "yourself,"
  },
  {
   "start": 62.718,
   "end": 63.598,
   "text": "and the catch"
  },
  {
   "start": 63.598,
   "end": 64.458,
   "text": "lands on that"
  },
  {
   "start": 64.458,
   "end": 65.278,
   "text": "band."
  },
  {
   "start": 65.278,
   "end": 65.878,
   "text": "The pain is"
  },
  {
   "start": 65.878,
   "end": 66.518,
   "text": "not the first"
  },
  {
   "start": 66.518,
   "end": 67.598,
   "text": "thing that happened."
  },
  {
   "start": 67.598,
   "end": 67.918,
   "text": "It is the"
  },
  {
   "start": 67.918,
   "end": 68.558,
   "text": "first thing you"
  },
  {
   "start": 68.558,
   "end": 69.028,
   "text": "noticed."
  },
  {
   "start": 69.478,
   "end": 69.978,
   "text": "You have been"
  },
  {
   "start": 69.978,
   "end": 70.718,
   "text": "told it is"
  },
  {
   "start": 70.718,
   "end": 71.158,
   "text": "your age."
  },
  {
   "start": 71.158,
   "end": 72.158,
   "text": "Or your weight."
  },
  {
   "start": 72.158,
   "end": 73.098,
   "text": "Or that the"
  },
