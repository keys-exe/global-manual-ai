{
 "cards": [
  {
   "start": 0.0,
   "end": 0.78,
   "text": "A bad knee"
  },
  {
   "start": 0.78,
   "end": 1.86,
   "text": "is not a"
  },
  {
   "start": 1.86,
   "end": 2.65,
   "text": "knee problem."
  },
  {
   "start": 2.98,
   "end": 3.46,
   "text": "It is a"
  },
  {
   "start": 3.46,
   "end": 4.08,
   "text": "weight problem,"
  },
  {
   "start": 4.08,
   "end": 4.94,
   "text": "and the weight"
  },
  {
   "start": 4.94,
   "end": 5.7,
   "text": "has to go"
  },
  {
   "start": 5.7,
   "end": 6.31,
   "text": "somewhere."
  },
  {
   "start": 6.76,
   "end": 7.42,
   "text": "I fit stair"
  },
  {
   "start": 7.42,
   "end": 7.98,
   "text": "rails for a"
  },
  {
   "start": 7.98,
   "end": 8.45,
   "text": "living."
  },
  {
   "start": 8.72,
   "end": 9.16,
   "text": "I have been"
  },
  {
   "start": 9.16,
   "end": 9.8,
   "text": "in about four"
  },
  {
   "start": 9.8,
   "end": 10.94,
   "text": "hundred houses and"
  },
  {
   "start": 10.94,
   "end": 11.6,
   "text": "I have watched"
  },
  {
   "start": 11.6,
   "end": 12.49,
   "text": "where it goes."
  },
  {
   "start": 12.8,
   "end": 13.46,
   "text": "I need you"
  },
  {
   "start": 13.46,
   "end": 14.1,
   "text": "to take this"
  },
  {
   "start": 14.1,
   "end": 14.958,
   "text": "seriously."
  },
  {
   "start": 14.958,
   "end": 15.578,
   "text": "Here is the"
  },
  {
   "start": 15.578,
   "end": 16.178,
   "text": "sequence,"
  },
  {
   "start": 16.178,
   "end": 16.578,
   "text": "and it is"
  },
  {
   "start": 16.578,
   "end": 17.578,
   "text": "almost always the"
  },
  {
   "start": 17.578,
   "end": 18.108,
   "text": "same."
  },
  {
   "start": 18.398,
   "end": 19.078,
   "text": "One knee starts"
  },
  {
   "start": 19.078,
   "end": 19.658,
   "text": "hurting on the"
  },
  {
   "start": 19.658,
   "end": 20.398,
   "text": "stairs."
  },
  {
   "start": 20.398,
   "end": 21.038,
   "text": "So you favour"
  },
  {
   "start": 21.038,
   "end": 21.618,
   "text": "it."
  },
  {
   "start": 21.618,
   "end": 22.178,
   "text": "You lead with"
  },
  {
   "start": 22.178,
   "end": 22.978,
   "text": "the good leg,"
  },
  {
   "start": 22.978,
   "end": 24.038,
   "text": "every step."
  },
  {
   "start": 24.038,
   "end": 24.598,
   "text": "The good leg"
  },
  {
   "start": 24.598,
   "end": 25.218,
   "text": "is now doing"
  },
  {
   "start": 25.218,
   "end": 25.698,
   "text": "the work of"
  },
  {
   "start": 25.698,
   "end": 26.478,
   "text": "two."
  },
  {
   "start": 26.478,
   "end": 26.958,
   "text": "Within a year"
  },
  {
   "start": 26.958,
   "end": 27.618,
   "text": "or two it"
  },
  {
   "start": 27.618,
   "end": 28.818,
   "text": "starts as well."
  },
  {
   "start": 28.818,
   "end": 29.478,
   "text": "Then a rail"
  },
  {
   "start": 29.478,
   "end": 30.458,
   "text": "at the top."
  },
  {
   "start": 30.458,
   "end": 31.238,
   "text": "Then a rail"
  },
  {
   "start": 31.238,
   "end": 31.778,
   "text": "all the way"
  },
  {
   "start": 31.778,
   "end": 32.498,
   "text": "down."
  },
  {
   "start": 32.498,
   "end": 33.278,
   "text": "Then you stop"
  },
  {
   "start": 33.278,
   "end": 33.878,
   "text": "going up in"
  },
  {
   "start": 33.878,
   "end": 34.838,
   "text": "the afternoon."
  },
  {
   "start": 34.838,
   "end": 35.578,
   "text": "Then a bed"
  },
  {
   "start": 35.578,
   "end": 36.358,
   "text": "comes downstairs."
  },
  {
   "start": 36.358,
   "end": 37.298,
   "text": "I am not"
  },
  {
   "start": 37.298,
   "end": 37.918,
   "text": "telling you that"
  },
  {
   "start": 37.918,
   "end": 39.118,
   "text": "to frighten you."
  },
  {
   "start": 39.118,
   "end": 39.898,
   "text": "Every step on"
  },
  {
   "start": 39.898,
   "end": 40.538,
   "text": "that list is"
  },
  {
   "start": 40.538,
   "end": 41.318,
   "text": "a response to"
  },
  {
   "start": 41.318,
   "end": 42.298,
   "text": "weight landing in"
  },
  {
   "start": 42.298,
   "end": 42.918,
   "text": "one place."
  },
  {
   "start": 42.918,
   "end": 44.298,
   "text": "Two centimetres below"
  },
  {
   "start": 44.298,
   "end": 45.178,
   "text": "your kneecap there"
  },
  {
   "start": 45.178,
   "end": 45.618,
   "text": "is a band"
  },
  {
   "start": 45.618,
   "end": 46.478,
   "text": "of tendon about"
  },
  {
   "start": 46.478,
   "end": 47.038,
   "text": "as wide as"
  },
  {
   "start": 47.038,
   "end": 47.688,
   "text": "your thumb."
  },
  {
   "start": 47.998,
   "end": 48.598,
   "text": "Every step you"
  },
  {
   "start": 48.598,
   "end": 49.558,
   "text": "take lands on"
  },
  {
   "start": 49.558,
   "end": 50.318,
   "text": "it."
  },
  {
   "start": 50.318,
   "end": 51.498,
   "text": "Seventeen times your"
  },
  {
   "start": 51.498,
   "end": 52.378,
   "text": "bodyweight."
  },
  {
   "start": 52.378,
   "end": 52.898,
   "text": "Put your finger"
  },
  {
   "start": 52.898,
   "end": 53.928,
   "text": "there and press."
  },
  {
   "start": 54.258,
   "end": 54.878,
   "text": "That is the"
  },
  {
   "start": 54.878,
   "end": 55.598,
   "text": "band."
  },
  {
   "start": 55.598,
   "end": 56.458,
   "text": "Coming down is"
  },
  {
   "start": 56.458,
   "end": 57.178,
   "text": "worse than going"
  },
  {
   "start": 57.178,
   "end": 57.858,
   "text": "up."
  },
  {
   "start": 57.858,
   "end": 58.538,
   "text": "Going up,"
  },
  {
   "start": 58.538,
   "end": 59.278,
   "text": "your muscles lift"
  },
  {
   "start": 59.278,
   "end": 59.818,
   "text": "you."
  },
  {
   "start": 59.818,
   "end": 60.918,
   "text": "Coming down,"
  },
  {
   "start": 60.918,
   "end": 61.878,
   "text": "nothing does."
  },
  {
   "start": 61.878,
   "end": 62.478,
   "text": "You are catching"
  },
  {
   "start": 62.478,
   "end": 63.058,
   "text": "yourself,"
  },
  {
   "start": 63.058,
   "end": 63.798,
   "text": "and the catch"
  },
  {
   "start": 63.798,
   "end": 64.558,
   "text": "lands on that"
  },
  {
   "start": 64.558,
   "end": 65.298,
   "text": "band."
  },
  {
   "start": 65.298,
   "end": 65.958,
   "text": "The pain is"
  },
  {
   "start": 65.958,
   "end": 66.578,
   "text": "not the first"
  },
  {
   "start": 66.578,
   "end": 67.458,
   "text": "thing that happened."
  },
  {
   "start": 67.458,
   "end": 68.038,
   "text": "It is the"
  },
  {
   "start": 68.038,
   "end": 68.718,
   "text": "first thing you"
  },
  {
   "start": 68.718,
   "end": 69.098,
   "text": "noticed."
  },
  {
   "start": 69.098,
   "end": 70.058,
   "text": "You have been"
  },
  {
   "start": 70.058,
   "end": 70.778,
   "text": "told it is"
  },
  {
   "start": 70.778,
   "end": 71.498,
   "text": "your age."
  },
  {
   "start": 71.498,
   "end": 72.478,
   "text": "Or your weight."
  },
  {
   "start": 72.478,
   "end": 73.238,
   "text": "Or that the"
  },
  {
   "start": 73.238,
   "end": 74.318,
   "text": "muscle is weak."
  },
  {
   "start": 74.318,
   "end": 75.138,
   "text": "Sometimes that is"
  },
