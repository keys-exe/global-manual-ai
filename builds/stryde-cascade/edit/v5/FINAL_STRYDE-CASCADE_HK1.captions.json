   "end": 7.86,
   "text": "rails for a"
  },
  {
   "start": 7.86,
   "end": 8.35,
   "text": "living."
  },
  {
   "start": 8.66,
   "end": 9.1,
   "text": "I have been"
  },
  {
   "start": 9.1,
   "end": 9.61,
   "text": "in about four"
  },
  {
   "start": 9.61,
   "end": 10.9,
   "text": "hundred houses and"
  },
  {
   "start": 10.9,
   "end": 11.42,
   "text": "I have watched"
  },
  {
   "start": 11.42,
   "end": 12.31,
   "text": "where it goes."
  },
  {
   "start": 12.76,
   "end": 13.4,
   "text": "I need you"
  },
  {
   "start": 13.4,
   "end": 14.0,
   "text": "to take this"
  },
  {
   "start": 14.0,
   "end": 14.59,
   "text": "seriously."
  },
  {
   "start": 14.958,
   "end": 15.458,
   "text": "Here is the"
  },
  {
   "start": 15.458,
   "end": 15.738,
   "text": "sequence,"
  },
  {
   "start": 15.738,
   "end": 16.478,
   "text": "and it is"
  },
  {
   "start": 16.478,
   "end": 17.478,
   "text": "almost always the"
  },
  {
   "start": 17.478,
   "end": 17.988,
   "text": "same."
  },
  {
   "start": 18.298,
   "end": 18.918,
   "text": "One knee starts"
  },
  {
   "start": 18.918,
   "end": 19.558,
   "text": "hurting on the"
  },
  {
   "start": 19.558,
   "end": 20.298,
   "text": "stairs."
  },
  {
   "start": 20.298,
   "end": 20.858,
   "text": "So you favour"
  },
  {
   "start": 20.858,
   "end": 21.578,
   "text": "it."
  },
  {
   "start": 21.578,
   "end": 22.098,
   "text": "You lead with"
  },
  {
   "start": 22.098,
   "end": 22.858,
   "text": "the good leg,"
  },
  {
   "start": 22.858,
   "end": 23.938,
   "text": "every step."
  },
  {
   "start": 23.938,
   "end": 24.498,
   "text": "The good leg"
  },
  {
   "start": 24.498,
   "end": 25.178,
   "text": "is now doing"
  },
  {
   "start": 25.178,
   "end": 25.638,
   "text": "the work of"
  },
  {
   "start": 25.638,
   "end": 26.108,
   "text": "two."
  },
  {
   "start": 26.458,
   "end": 26.898,
   "text": "Within a year"
  },
  {
   "start": 26.898,
   "end": 27.558,
   "text": "or two it"
  },
  {
   "start": 27.558,
   "end": 28.428,
   "text": "starts as well."
  },
  {
   "start": 28.958,
   "end": 29.418,
   "text": "Then a rail"
  },
  {
   "start": 29.418,
   "end": 30.148,
   "text": "at the top."
  },
  {
   "start": 30.478,
   "end": 31.118,
   "text": "Then a rail"
  },
  {
   "start": 31.118,
   "end": 31.678,
   "text": "all the way"
  },
  {
   "start": 31.678,
   "end": 32.168,
   "text": "down."
  },
  {
   "start": 32.438,
   "end": 33.138,
   "text": "Then you stop"
  },
  {
   "start": 33.138,
   "end": 33.818,
   "text": "going up in"
  },
  {
   "start": 33.818,
   "end": 34.348,
   "text": "the afternoon."
  },
  {
   "start": 34.838,
   "end": 35.498,
   "text": "Then a bed"
  },
  {
   "start": 35.498,
   "end": 35.998,
   "text": "comes downstairs."
  },
  {
   "start": 35.998,
   "end": 37.198,
   "text": "I am not"
  },
  {
   "start": 37.198,
   "end": 37.838,
   "text": "telling you that"
  },
  {
   "start": 37.838,
   "end": 38.958,
   "text": "to frighten you."
  },
  {
   "start": 38.958,
   "end": 39.798,
   "text": "Every step on"
  },
  {
   "start": 39.798,
   "end": 40.498,
   "text": "that list is"
  },
  {
   "start": 40.498,
   "end": 41.198,
   "text": "a response to"
  },
  {
   "start": 41.198,
   "end": 42.178,
   "text": "weight landing in"
