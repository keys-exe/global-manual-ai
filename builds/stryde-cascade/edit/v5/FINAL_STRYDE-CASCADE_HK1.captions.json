  {
   "start": 98.438,
   "end": 99.438,
   "text": "centimetres below the"
  },
  {
   "start": 99.438,
   "end": 99.818,
   "text": "kneecap,"
  },
  {
   "start": 99.818,
   "end": 101.018,
   "text": "on the tendon."
  },
  {
   "start": 101.018,
   "end": 101.978,
   "text": "It never crosses"
  },
  {
   "start": 101.978,
   "end": 102.728,
   "text": "the joint."
  },
  {
   "start": 103.058,
   "end": 103.418,
   "text": "There is a"
  },
  {
   "start": 103.418,
   "end": 104.478,
   "text": "silicone pad inside"
  },
  {
   "start": 104.478,
   "end": 105.438,
   "text": "that holds pressure"
  },
  {
   "start": 105.438,
   "end": 106.178,
   "text": "on that one"
  },
  {
   "start": 106.178,
   "end": 107.298,
