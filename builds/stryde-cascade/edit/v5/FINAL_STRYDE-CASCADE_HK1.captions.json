   "start": 114.218,
   "end": 115.578,
   "text": "the whole thing."
  },
  {
   "start": 115.578,
   "end": 116.058,
   "text": "A little too"
  },
  {
   "start": 116.058,
   "end": 116.958,
   "text": "high and it"
  },
  {
   "start": 116.958,
   "end": 117.418,
   "text": "is a sleeve"
