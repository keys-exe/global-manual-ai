  {
   "start": 157.878,
   "end": 158.738,
   "text": "and a stretched"
  },
  {
   "start": 158.738,
   "end": 159.758,
   "text": "strap does not"
  },
  {
   "start": 159.758,
   "end": 160.898,
   "text": "hold the spot."
  },
  {
   "start": 160.898,
   "end": 161.178,
   "text": "And if you"
  },
  {
   "start": 161.178,
   "end": 161.898,
   "text": "know somebody whose"
  },
  {
   "start": 161.898,
   "end": 162.618,
   "text": "stairs have started"
  },
  {
   "start": 162.618,
   "end": 163.818,
   "text": "taking them longer,"
  },
  {
   "start": 163.818,
   "end": 164.708,
   "text": "send them this."
