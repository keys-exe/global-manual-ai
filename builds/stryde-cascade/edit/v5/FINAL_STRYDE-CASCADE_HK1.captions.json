   "end": 139.918,
   "text": "there."
  },
  {
   "start": 139.918,
   "end": 140.598,
   "text": "Because the weight"
  },
  {
   "start": 140.598,
   "end": 141.358,
   "text": "is not landing"
  },
  {
   "start": 141.358,
   "end": 141.998,
