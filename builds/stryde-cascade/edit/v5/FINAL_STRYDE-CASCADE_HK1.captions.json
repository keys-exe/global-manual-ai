   "start": 51.398,
   "end": 52.298,
   "text": "bodyweight."
  },
  {
   "start": 52.298,
   "end": 52.818,
   "text": "Put your finger"
  },
  {
   "start": 52.818,
   "end": 53.788,
   "text": "there and press."
  },
  {
   "start": 54.178,
   "end": 54.798,
   "text": "That is the"
  },
  {
   "start": 54.798,
   "end": 55.478,
   "text": "band."
  },
  {
   "start": 55.478,
   "end": 56.378,
   "text": "Coming down is"
  },
  {
   "start": 56.378,
   "end": 57.098,
   "text": "worse than going"
  },
  {
   "start": 57.098,
   "end": 57.738,
   "text": "up."
  },
  {
   "start": 57.738,
   "end": 58.418,
   "text": "Going up,"
  },
  {
   "start": 58.418,
   "end": 59.158,
   "text": "your muscles lift"
  },
