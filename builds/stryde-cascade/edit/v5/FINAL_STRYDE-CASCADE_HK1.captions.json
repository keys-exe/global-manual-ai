   "start": 151.778,
   "end": 152.438,
   "text": "both knees,"
  },
  {
   "start": 152.438,
   "end": 152.938,
   "text": "which is the"
  },
  {
   "start": 152.938,
   "end": 153.198,
   "text": "point."
  },
  {
   "start": 153.198,
   "end": 154.338,
   "text": "Sixty days,"
  },
  {
   "start": 154.338,
   "end": 154.998,
   "text": "and you keep"
  },
  {
   "start": 154.998,
   "end": 155.518,
   "text": "the straps."
  },
  {
   "start": 155.518,
   "end": 156.478,
   "text": "From the Stryde"
  },
  {
   "start": 156.478,
   "end": 157.278,
   "text": "site."
  },
  {
   "start": 157.278,
   "end": 158.118,
   "text": "The copies stretch,"
  },
  {
   "start": 158.118,
   "end": 158.998,
   "text": "and a stretched"
  },
  {
   "start": 158.998,
   "end": 159.858,
   "text": "strap does not"
  },
  {
   "start": 159.858,
   "end": 160.998,
   "text": "hold the spot."
  },
  {
   "start": 160.998,
   "end": 161.238,
   "text": "And if you"
  },
  {
   "start": 161.238,
   "end": 161.998,
   "text": "know somebody whose"
  },
  {
   "start": 161.998,
   "end": 162.758,
   "text": "stairs have started"
  },
  {
   "start": 162.758,
   "end": 164.078,
   "text": "taking them longer,"
  },
  {
   "start": 164.078,
   "end": 165.098,
   "text": "send them this."
