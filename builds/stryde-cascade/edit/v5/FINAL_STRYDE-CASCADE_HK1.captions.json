{
 "cards": [
  {
   "start": 0.0,
   "end": 0.62,
   "text": "A bad knee"
  },
  {
   "start": 0.62,
   "end": 1.76,
   "text": "is not a"
  },
  {
   "start": 1.76,
   "end": 2.45,
   "text": "knee problem."
  },
  {
   "start": 3.04,
   "end": 3.3,
   "text": "It is a"
  },
  {
   "start": 3.3,
   "end": 4.32,
   "text": "weight problem,"
  },
  {
   "start": 4.32,
   "end": 4.82,
   "text": "and the weight"
  },
  {
   "start": 4.82,
   "end": 5.58,
   "text": "has to go"
  },
  {
   "start": 5.58,
   "end": 6.11,
   "text": "somewhere."
  },
  {
   "start": 6.7,
   "end": 7.26,
   "text": "I fit stair"
  },
