  },
  {
   "start": 152.518,
   "end": 152.838,
   "text": "which is the"
  },
  {
   "start": 152.838,
   "end": 153.078,
   "text": "point."
  },
  {
   "start": 153.078,
   "end": 154.158,
   "text": "Sixty days,"
  },
  {
   "start": 154.158,
   "end": 154.898,
   "text": "and you keep"
