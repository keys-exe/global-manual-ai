   "start": 151.552,
   "end": 152.272,
   "text": "both knees,"
  },
  {
   "start": 152.272,
   "end": 152.712,
   "text": "which is the"
  },
  {
   "start": 152.712,
   "end": 152.972,
   "text": "point."
  },
  {
   "start": 152.972,
   "end": 154.212,
   "text": "Sixty days,"
  },
  {
   "start": 154.212,
   "end": 154.692,
   "text": "and you keep"
  },
  {
   "start": 154.692,
   "end": 155.592,
   "text": "the straps."
  },
  {
   "start": 155.592,
   "end": 156.252,
   "text": "From the Stryde"
