   "start": 113.912,
   "end": 115.272,
   "text": "the whole thing."
  },
  {
   "start": 115.272,
   "end": 115.772,
   "text": "A little too"
  },
  {
   "start": 115.772,
   "end": 116.592,
   "text": "high and it"
  },
  {
   "start": 116.592,
   "end": 117.092,
   "text": "is a sleeve"
