{
 "cards": [
  {
   "start": 0.0,
   "end": 0.76,
   "text": "A bad knee"
  },
  {
   "start": 0.76,
   "end": 1.76,
   "text": "is not a"
  },
  {
   "start": 1.76,
   "end": 2.55,
   "text": "knee problem."
  },
  {
   "start": 2.92,
   "end": 3.38,
   "text": "It is a"
  },
  {
   "start": 3.38,
   "end": 4.04,
   "text": "weight problem,"
  },
  {
   "start": 4.04,
   "end": 5.02,
   "text": "and the weight"
  },
  {
   "start": 5.02,
   "end": 5.8,
   "text": "has to go"
  },
  {
   "start": 5.8,
   "end": 6.39,
   "text": "somewhere."
  },
  {
   "start": 6.86,
   "end": 7.52,
   "text": "I fit stair"
  },
  {
   "start": 7.52,
   "end": 8.08,
   "text": "rails for a"
  },
  {
   "start": 8.08,
   "end": 8.8,
   "text": "living."
  },
  {
   "start": 8.8,
   "end": 9.22,
   "text": "I have been"
  },
  {
   "start": 9.22,
   "end": 9.8,
   "text": "in about four"
  },
  {
   "start": 9.8,
   "end": 10.96,
   "text": "hundred houses and"
  },
  {
   "start": 10.96,
   "end": 11.56,
   "text": "I have watched"
  },
  {
   "start": 11.56,
   "end": 12.45,
   "text": "where it goes."
  },
  {
   "start": 12.82,
   "end": 13.42,
   "text": "I need you"
  },
  {
   "start": 13.42,
   "end": 13.98,
   "text": "to take this"
  },
  {
   "start": 13.98,
   "end": 14.792,
   "text": "seriously."
  },
  {
   "start": 14.792,
   "end": 15.452,
   "text": "Here is the"
  },
  {
   "start": 15.452,
   "end": 16.012,
   "text": "sequence,"
  },
  {
   "start": 16.012,
   "end": 16.452,
   "text": "and it is"
  },
  {
   "start": 16.452,
   "end": 17.412,
   "text": "almost always the"
  },
  {
   "start": 17.412,
   "end": 18.212,
   "text": "same."
  },
  {
   "start": 18.212,
   "end": 18.952,
   "text": "One knee starts"
  },
  {
   "start": 18.952,
   "end": 19.532,
   "text": "hurting on the"
  },
  {
   "start": 19.532,
   "end": 20.272,
   "text": "stairs."
  },
  {
   "start": 20.272,
   "end": 20.892,
   "text": "So you favour"
  },
  {
   "start": 20.892,
   "end": 21.492,
   "text": "it."
  },
  {
   "start": 21.492,
   "end": 22.052,
   "text": "You lead with"
  },
  {
   "start": 22.052,
   "end": 22.852,
   "text": "the good leg,"
  },
  {
   "start": 22.852,
   "end": 23.892,
   "text": "every step."
  },
  {
   "start": 23.892,
   "end": 24.432,
   "text": "The good leg"
  },
  {
   "start": 24.432,
   "end": 25.032,
   "text": "is now doing"
  },
  {
   "start": 25.032,
   "end": 25.532,
   "text": "the work of"
  },
  {
   "start": 25.532,
   "end": 26.272,
   "text": "two."
  },
  {
   "start": 26.272,
   "end": 26.772,
   "text": "Within a year"
  },
  {
   "start": 26.772,
   "end": 27.492,
   "text": "or two it"
  },
  {
   "start": 27.492,
   "end": 28.652,
   "text": "starts as well."
  },
  {
   "start": 28.652,
   "end": 29.312,
   "text": "Then a rail"
  },
  {
   "start": 29.312,
   "end": 30.212,
   "text": "at the top."
  },
  {
   "start": 30.212,
   "end": 31.032,
   "text": "Then a rail"
  },
  {
   "start": 31.032,
   "end": 31.632,
   "text": "all the way"
  },
  {
   "start": 31.632,
   "end": 32.332,
   "text": "down."
  },
  {
   "start": 32.332,
   "end": 33.012,
   "text": "Then you stop"
  },
  {
   "start": 33.012,
   "end": 33.552,
   "text": "going up in"
  },
  {
   "start": 33.552,
   "end": 34.532,
   "text": "the afternoon."
  },
  {
   "start": 34.532,
   "end": 35.312,
   "text": "Then a bed"
  },
  {
   "start": 35.312,
   "end": 36.322,
   "text": "comes downstairs."
  },
  {
   "start": 36.632,
   "end": 36.992,
   "text": "I am not"
  },
  {
   "start": 36.992,
   "end": 37.592,
   "text": "telling you that"
  },
  {
   "start": 37.592,
   "end": 38.712,
   "text": "to frighten you."
  },
  {
   "start": 38.712,
   "end": 39.492,
   "text": "Every step on"
  },
  {
   "start": 39.492,
   "end": 40.132,
   "text": "that list is"
  },
  {
   "start": 40.132,
   "end": 40.912,
   "text": "a response to"
  },
  {
   "start": 40.912,
   "end": 41.932,
   "text": "weight landing in"
  },
  {
   "start": 41.932,
   "end": 42.532,
   "text": "one place."
  },
  {
   "start": 42.532,
   "end": 43.952,
   "text": "Two centimetres below"
  },
  {
   "start": 43.952,
   "end": 44.852,
   "text": "your kneecap there"
  },
  {
   "start": 44.852,
   "end": 45.312,
   "text": "is a band"
  },
  {
   "start": 45.312,
   "end": 46.172,
   "text": "of tendon about"
  },
  {
   "start": 46.172,
   "end": 46.732,
   "text": "as wide as"
  },
  {
   "start": 46.732,
   "end": 47.592,
   "text": "your thumb."
  },
  {
   "start": 47.592,
   "end": 48.332,
   "text": "Every step you"
  },
  {
   "start": 48.332,
   "end": 49.352,
   "text": "take lands on"
  },
  {
   "start": 49.352,
   "end": 50.112,
   "text": "it."
  },
  {
   "start": 50.112,
   "end": 51.212,
   "text": "Seventeen times your"
  },
  {
   "start": 51.212,
   "end": 52.112,
   "text": "bodyweight."
  },
  {
   "start": 52.112,
   "end": 52.612,
   "text": "Put your finger"
  },
  {
   "start": 52.612,
   "end": 53.682,
   "text": "there and press."
  },
  {
   "start": 53.972,
   "end": 54.552,
   "text": "That is the"
  },
  {
   "start": 54.552,
   "end": 55.252,
   "text": "band."
  },
  {
   "start": 55.252,
   "end": 56.112,
   "text": "Coming down is"
  },
  {
   "start": 56.112,
   "end": 56.832,
   "text": "worse than going"
  },
  {
   "start": 56.832,
   "end": 57.472,
   "text": "up."
  },
  {
   "start": 57.472,
   "end": 58.172,
   "text": "Going up,"
  },
  {
   "start": 58.172,
   "end": 58.932,
   "text": "your muscles lift"
  },
  {
   "start": 58.932,
   "end": 59.512,
   "text": "you."
  },
  {
   "start": 59.512,
   "end": 60.422,
   "text": "Coming down,"
  },
  {
   "start": 60.692,
   "end": 61.632,
   "text": "nothing does."
  },
  {
   "start": 61.632,
   "end": 62.232,
   "text": "You are catching"
  },
  {
   "start": 62.232,
   "end": 62.832,
   "text": "yourself,"
  },
  {
   "start": 62.832,
   "end": 63.572,
   "text": "and the catch"
  },
  {
   "start": 63.572,
   "end": 64.432,
   "text": "lands on that"
  },
  {
   "start": 64.432,
   "end": 65.192,
   "text": "band."
  },
  {
   "start": 65.192,
   "end": 65.892,
   "text": "The pain is"
  },
  {
   "start": 65.892,
   "end": 66.532,
   "text": "not the first"
  },
  {
   "start": 66.532,
   "end": 67.432,
   "text": "thing that happened."
  },
  {
   "start": 67.432,
   "end": 67.892,
   "text": "It is the"
  },
  {
   "start": 67.892,
   "end": 68.572,
   "text": "first thing you"
  },
  {
   "start": 68.572,
   "end": 69.392,
   "text": "noticed."
  },
  {
   "start": 69.392,
   "end": 69.892,
   "text": "You have been"
  },
  {
   "start": 69.892,
   "end": 70.512,
   "text": "told it is"
  },
  {
   "start": 70.512,
   "end": 71.152,
   "text": "your age."
  },
  {
   "start": 71.152,
   "end": 72.072,
   "text": "Or your weight."
  },
  {
   "start": 72.072,
   "end": 72.872,
   "text": "Or that the"
  },
  {
   "start": 72.872,
   "end": 74.032,
   "text": "muscle is weak."
  },
  {
   "start": 74.032,
   "end": 74.892,
   "text": "Sometimes that is"
