   "start": 88.858,
   "end": 89.818,
   "text": "are wrong."
  },
  {
   "start": 89.818,
   "end": 90.298,
   "text": "None of them"
  },
  {
   "start": 90.298,
   "end": 90.998,
   "text": "move the weight"
  },
  {
   "start": 90.998,
   "end": 91.978,
   "text": "off the band,"
  },
  {
   "start": 91.978,
   "end": 92.718,
   "text": "and that is"
  },
  {
   "start": 92.718,
   "end": 93.538,
   "text": "the only thing"
  },
  {
   "start": 93.538,
   "end": 94.238,
   "text": "that stops the"
  },
  {
   "start": 94.238,
   "end": 95.098,
   "text": "sequence."
  },
  {
   "start": 95.098,
   "end": 95.638,
   "text": "The strap I"
  },
  {
   "start": 95.638,
   "end": 96.098,
   "text": "keep in the"
  },
  {
   "start": 96.098,
   "end": 96.738,
   "text": "van now is"
  },
