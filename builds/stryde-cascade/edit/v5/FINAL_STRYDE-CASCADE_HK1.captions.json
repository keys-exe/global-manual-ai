   "start": 156.252,
   "end": 156.472,
   "text": "site."
  },
  {
   "start": 156.472,
   "end": 158.132,
   "text": "The copies stretch,"
  },
  {
   "start": 158.132,
   "end": 158.672,
   "text": "and a stretched"
  },
  {
   "start": 158.672,
   "end": 159.572,
   "text": "strap does not"
  },
  {
   "start": 159.572,
   "end": 160.672,
   "text": "hold the spot."
  },
  {
   "start": 160.672,
   "end": 160.972,
   "text": "And if you"
  },
  {
   "start": 160.972,
   "end": 161.712,
   "text": "know somebody whose"
  },
  {
   "start": 161.712,
   "end": 162.492,
   "text": "stairs have started"
  },
  {
   "start": 162.492,
   "end": 163.752,
   "text": "taking them longer,"
  },
  {
   "start": 163.752,
   "end": 164.772,
   "text": "send them this."
