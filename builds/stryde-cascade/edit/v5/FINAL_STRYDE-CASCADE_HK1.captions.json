  {
   "start": 117.418,
   "end": 117.778,
   "text": "again."
  },
  {
   "start": 117.778,
   "end": 119.238,
   "text": "Thirty four percent"
  },
  {
   "start": 119.238,
   "end": 120.288,
   "text": "less strain."
  },
  {
   "start": 120.638,
   "end": 121.248,
   "text": "Measured."
  },
  {
   "start": 121.518,
   "end": 122.318,
   "text": "Three years with"
