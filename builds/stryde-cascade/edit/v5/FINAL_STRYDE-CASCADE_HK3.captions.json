{
 "cards": [
  {
   "start": 0.0,
   "end": 0.84,
   "text": "When I am"
  },
  {
   "start": 0.84,
   "end": 1.38,
   "text": "asked to move"
  },
  {
   "start": 1.38,
   "end": 1.9,
   "text": "a bed into"
  },
  {
   "start": 1.9,
   "end": 3.0,
   "text": "a front room,"
  },
  {
   "start": 3.0,
   "end": 3.44,
   "text": "the knee has"
  },
  {
   "start": 3.44,
   "end": 4.22,
   "text": "usually been bad"
  },
  {
   "start": 4.22,
   "end": 4.9,
   "text": "for about six"
  },
  {
   "start": 4.9,
   "end": 5.51,
   "text": "years."
  },
  {
   "start": 6.04,
   "end": 6.76,
   "text": "Nobody plans for"
  },
  {
   "start": 6.76,
   "end": 7.19,
   "text": "that."
  },
  {
   "start": 7.46,
   "end": 8.28,
   "text": "It arrives one"
  },
  {
   "start": 8.28,
   "end": 9.28,
   "text": "small change at"
  },
  {
   "start": 9.28,
   "end": 9.62,
   "text": "a time,"
  },
  {
   "start": 9.62,
   "end": 10.38,
   "text": "and I can"
  },
  {
   "start": 10.38,
   "end": 11.32,
   "text": "name every one"
  },
  {
   "start": 11.32,
   "end": 11.875,
   "text": "of them."
  },
  {
   "start": 11.875,
   "end": 12.375,
   "text": "Here is the"
  },
  {
   "start": 12.375,
   "end": 12.655,
   "text": "sequence,"
  },
  {
   "start": 12.655,
   "end": 13.395,
   "text": "and it is"
  },
  {
   "start": 13.395,
   "end": 14.395,
   "text": "almost always the"
  },
  {
   "start": 14.395,
   "end": 14.905,
   "text": "same."
  },
  {
   "start": 15.215,
   "end": 15.835,
   "text": "One knee starts"
  },
  {
   "start": 15.835,
   "end": 16.475,
   "text": "hurting on the"
  },
  {
   "start": 16.475,
   "end": 17.215,
   "text": "stairs."
  },
  {
   "start": 17.215,
   "end": 17.775,
   "text": "So you favour"
  },
  {
   "start": 17.775,
   "end": 18.495,
   "text": "it."
  },
  {
   "start": 18.495,
   "end": 19.015,
   "text": "You lead with"
  },
  {
   "start": 19.015,
   "end": 19.775,
   "text": "the good leg,"
  },
  {
   "start": 19.775,
   "end": 20.855,
   "text": "every step."
  },
  {
   "start": 20.855,
   "end": 21.415,
   "text": "The good leg"
  },
  {
   "start": 21.415,
   "end": 22.095,
   "text": "is now doing"
  },
  {
   "start": 22.095,
   "end": 22.555,
   "text": "the work of"
  },
  {
   "start": 22.555,
   "end": 23.025,
   "text": "two."
  },
  {
   "start": 23.375,
   "end": 23.815,
   "text": "Within a year"
  },
  {
   "start": 23.815,
   "end": 24.475,
   "text": "or two it"
  },
  {
   "start": 24.475,
   "end": 25.345,
   "text": "starts as well."
  },
  {
   "start": 25.875,
   "end": 26.335,
   "text": "Then a rail"
  },
  {
   "start": 26.335,
   "end": 27.065,
   "text": "at the top."
  },
  {
   "start": 27.395,
   "end": 28.035,
   "text": "Then a rail"
  },
  {
   "start": 28.035,
   "end": 28.595,
   "text": "all the way"
  },
  {
   "start": 28.595,
   "end": 29.085,
   "text": "down."
  },
  {
   "start": 29.355,
   "end": 30.055,
   "text": "Then you stop"
  },
  {
   "start": 30.055,
   "end": 30.735,
   "text": "going up in"
  },
  {
   "start": 30.735,
   "end": 31.265,
   "text": "the afternoon."
  },
  {
   "start": 31.755,
   "end": 32.415,
   "text": "Then a bed"
  },
  {
   "start": 32.415,
   "end": 32.915,
   "text": "comes downstairs."
  },
  {
   "start": 32.915,
   "end": 34.115,
   "text": "I am not"
  },
  {
   "start": 34.115,
   "end": 34.755,
   "text": "telling you that"
  },
  {
   "start": 34.755,
   "end": 35.875,
   "text": "to frighten you."
  },
  {
   "start": 35.875,
   "end": 36.715,
   "text": "Every step on"
  },
  {
   "start": 36.715,
   "end": 37.415,
   "text": "that list is"
  },
  {
   "start": 37.415,
   "end": 38.115,
   "text": "a response to"
  },
  {
   "start": 38.115,
   "end": 39.095,
   "text": "weight landing in"
  },
  {
   "start": 39.095,
   "end": 39.695,
   "text": "one place."
  },
  {
   "start": 39.695,
   "end": 41.075,
   "text": "Two centimetres below"
  },
  {
   "start": 41.075,
   "end": 42.055,
   "text": "your kneecap there"
  },
  {
   "start": 42.055,
   "end": 42.455,
   "text": "is a band"
  },
  {
   "start": 42.455,
   "end": 43.295,
   "text": "of tendon about"
  },
  {
   "start": 43.295,
   "end": 43.895,
   "text": "as wide as"
  },
  {
   "start": 43.895,
   "end": 44.715,
   "text": "your thumb."
  },
  {
   "start": 44.715,
   "end": 45.415,
   "text": "Every step you"
  },
  {
   "start": 45.415,
   "end": 46.415,
   "text": "take lands on"
  },
  {
   "start": 46.415,
   "end": 46.575,
   "text": "it."
  },
  {
   "start": 46.575,
   "end": 48.315,
   "text": "Seventeen times your"
  },
  {
   "start": 48.315,
   "end": 49.215,
   "text": "bodyweight."
  },
  {
   "start": 49.215,
   "end": 49.735,
   "text": "Put your finger"
  },
  {
   "start": 49.735,
   "end": 50.705,
   "text": "there and press."
  },
  {
   "start": 51.095,
   "end": 51.715,
   "text": "That is the"
  },
  {
   "start": 51.715,
   "end": 52.395,
   "text": "band."
  },
  {
   "start": 52.395,
   "end": 53.295,
   "text": "Coming down is"
  },
  {
   "start": 53.295,
   "end": 54.015,
   "text": "worse than going"
  },
  {
   "start": 54.015,
   "end": 54.655,
   "text": "up."
  },
  {
   "start": 54.655,
   "end": 55.335,
   "text": "Going up,"
  },
  {
   "start": 55.335,
   "end": 56.075,
   "text": "your muscles lift"
  },
  {
   "start": 56.075,
   "end": 56.715,
   "text": "you."
  },
  {
   "start": 56.715,
   "end": 57.595,
   "text": "Coming down,"
  },
  {
   "start": 57.595,
   "end": 58.735,
   "text": "nothing does."
  },
  {
   "start": 58.735,
   "end": 59.235,
   "text": "You are catching"
  },
  {
   "start": 59.235,
   "end": 59.635,
   "text": "yourself,"
  },
  {
   "start": 59.635,
   "end": 60.515,
   "text": "and the catch"
  },
  {
   "start": 60.515,
   "end": 61.375,
   "text": "lands on that"
  },
  {
   "start": 61.375,
   "end": 62.195,
   "text": "band."
  },
  {
   "start": 62.195,
   "end": 62.795,
   "text": "The pain is"
  },
  {
   "start": 62.795,
   "end": 63.435,
   "text": "not the first"
  },
  {
   "start": 63.435,
   "end": 64.515,
   "text": "thing that happened."
  },
  {
   "start": 64.515,
   "end": 64.835,
   "text": "It is the"
  },
  {
   "start": 64.835,
   "end": 65.475,
   "text": "first thing you"
  },
  {
   "start": 65.475,
   "end": 65.945,
   "text": "noticed."
  },
  {
   "start": 66.395,
   "end": 66.895,
   "text": "You have been"
  },
  {
   "start": 66.895,
   "end": 67.635,
   "text": "told it is"
  },
  {
   "start": 67.635,
   "end": 68.075,
   "text": "your age."
  },
  {
   "start": 68.075,
   "end": 69.075,
   "text": "Or your weight."
  },
  {
   "start": 69.075,
   "end": 70.015,
   "text": "Or that the"
  },
  {
   "start": 70.015,
   "end": 71.115,
   "text": "muscle is weak."
  },
  {
   "start": 71.115,
   "end": 71.995,
   "text": "Sometimes that is"
  },
  {
   "start": 71.995,
   "end": 72.855,
   "text": "part of it."
  },
  {
   "start": 72.855,
   "end": 73.375,
   "text": "It has never"
  },
  {
   "start": 73.375,
   "end": 73.935,
   "text": "been the whole"
  },
  {
   "start": 73.935,
   "end": 74.615,
   "text": "of it."
  },
  {
   "start": 74.615,
   "end": 75.335,
   "text": "The physio helps"
  },
  {
   "start": 75.335,
   "end": 76.275,
   "text": "and then stops"
  },
  {
   "start": 76.275,
   "end": 76.905,
   "text": "helping."
  },
  {
   "start": 77.195,
   "end": 77.895,
   "text": "The gel sits"
  },
  {
   "start": 77.895,
   "end": 78.745,
   "text": "on your skin."
  },
  {
   "start": 79.015,
   "end": 79.755,
   "text": "The pills switch"
  },
  {
   "start": 79.755,
   "end": 80.955,
   "text": "the alarm off."
  },
  {
   "start": 80.955,
   "end": 81.975,
   "text": "The sleeve squeezes"
  },
  {
   "start": 81.975,
   "end": 82.715,
   "text": "the whole knee"
  },
  {
   "start": 82.715,
   "end": 83.455,
   "text": "and leaves that"
  },
  {
   "start": 83.455,
   "end": 84.985,
   "text": "band carrying everything."
  },
  {
   "start": 85.255,
   "end": 85.735,
   "text": "None of them"
  },
  {
   "start": 85.735,
   "end": 86.365,
   "text": "are wrong."
  },
  {
   "start": 86.755,
   "end": 87.175,
   "text": "None of them"
  },
  {
   "start": 87.175,
   "end": 87.815,
   "text": "move the weight"
  },
  {
   "start": 87.815,
   "end": 88.975,
   "text": "off the band,"
  },
  {
   "start": 88.975,
   "end": 89.555,
   "text": "and that is"
  },
  {
   "start": 89.555,
   "end": 90.375,
   "text": "the only thing"
  },
  {
   "start": 90.375,
   "end": 91.055,
   "text": "that stops the"
  },
  {
   "start": 91.055,
   "end": 91.335,
   "text": "sequence."
  },
  {
   "start": 91.335,
   "end": 92.495,
   "text": "The strap I"
  },
  {
   "start": 92.495,
   "end": 92.895,
   "text": "keep in the"
  },
  {
   "start": 92.895,
   "end": 93.555,
   "text": "van now is"
  },
  {
   "start": 93.555,
   "end": 94.775,
   "text": "called Stryde."
  },
  {
   "start": 94.775,
   "end": 95.355,
   "text": "It sits two"
  },
  {
   "start": 95.355,
   "end": 96.355,
   "text": "centimetres below the"
  },
  {
   "start": 96.355,
   "end": 96.735,
   "text": "kneecap,"
  },
  {
   "start": 96.735,
   "end": 97.935,
   "text": "on the tendon."
  },
  {
   "start": 97.935,
   "end": 98.895,
   "text": "It never crosses"
  },
  {
   "start": 98.895,
   "end": 99.645,
   "text": "the joint."
  },
  {
   "start": 99.975,
   "end": 100.335,
   "text": "There is a"
  },
  {
   "start": 100.335,
   "end": 101.395,
   "text": "silicone pad inside"
  },
  {
   "start": 101.395,
   "end": 102.355,
   "text": "that holds pressure"
  },
  {
   "start": 102.355,
   "end": 103.095,
   "text": "on that one"
  },
  {
   "start": 103.095,
   "end": 104.215,
   "text": "band instead of"
  },
  {
   "start": 104.215,
   "end": 104.855,
   "text": "spreading it round"
  },
  {
   "start": 104.855,
   "end": 105.935,
   "text": "the whole knee."
  },
  {
   "start": 105.935,
   "end": 106.535,
   "text": "Your weight gets"
  },
  {
   "start": 106.535,
   "end": 107.415,
   "text": "caught and moved"
  },
  {
   "start": 107.415,
   "end": 108.175,
   "text": "off the worn"
  },
  {
   "start": 108.175,
   "end": 109.075,
   "text": "part before it"
  },
  {
   "start": 109.075,
   "end": 109.965,
   "text": "reaches the joint."
  },
  {
   "start": 110.255,
   "end": 111.055,
   "text": "The placement is"
  },
  {
   "start": 111.055,
   "end": 112.125,
   "text": "the whole thing."
  },
  {
   "start": 112.435,
   "end": 112.895,
   "text": "A little too"
  },
  {
   "start": 112.895,
   "end": 113.835,
   "text": "high and it"
  },
  {
   "start": 113.835,
   "end": 114.215,
   "text": "is a sleeve"
  },
  {
   "start": 114.215,
   "end": 114.495,
   "text": "again."
  },
  {
   "start": 114.495,
   "end": 116.075,
   "text": "Thirty four percent"
  },
  {
   "start": 116.075,
   "end": 117.025,
   "text": "less strain."
  },
  {
   "start": 117.335,
   "end": 117.985,
   "text": "Measured."
  },
  {
   "start": 118.575,
   "end": 119.135,
   "text": "Three years with"
  },
  {
   "start": 119.135,
   "end": 119.875,
   "text": "orthopedic surgeons."
  },
  {
   "start": 119.875,
   "end": 121.735,
   "text": "Two hundred thousand"
  },
  {
   "start": 121.735,
   "end": 122.975,
   "text": "people wearing one."
  },
  {
   "start": 122.975,
   "end": 123.375,
   "text": "I am not"
  },
  {
   "start": 123.375,
   "end": 124.245,
   "text": "paid by them."
  },
  {
   "start": 124.515,
   "end": 125.095,
   "text": "I started carrying"
  },
  {
   "start": 125.095,
   "end": 125.835,
   "text": "a couple because"
  },
  {
   "start": 125.835,
   "end": 126.395,
   "text": "I was tired"
  },
  {
   "start": 126.395,
   "end": 126.975,
   "text": "of fitting the"
  },
  {
   "start": 126.975,
   "end": 127.975,
   "text": "second rail."
  },
  {
   "start": 127.975,
   "end": 128.815,
   "text": "Three houses this"
  },
  {
   "start": 128.815,
   "end": 129.435,
   "text": "year have not"
  },
  {
   "start": 129.435,
   "end": 130.325,
   "text": "called me back."
  },
  {
   "start": 130.595,
   "end": 131.315,
   "text": "That is not"
  },
  {
   "start": 131.315,
   "end": 132.075,
   "text": "a study."
  },
  {
   "start": 132.075,
   "end": 132.495,
   "text": "It is just"
  },
  {
   "start": 132.495,
   "end": 132.875,
   "text": "what I have"
  },
  {
   "start": 132.875,
   "end": 133.515,
   "text": "seen."
  },
  {
   "start": 133.515,
   "end": 134.155,
   "text": "Not because the"
  },
  {
   "start": 134.155,
   "end": 135.245,
   "text": "arthritis is gone."
  },
  {
   "start": 135.515,
   "end": 135.995,
   "text": "It is still"
  },
  {
   "start": 135.995,
   "end": 136.545,
   "text": "there."
  },
  {
   "start": 136.815,
   "end": 137.395,
   "text": "Because the weight"
  },
  {
   "start": 137.395,
   "end": 138.215,
   "text": "is not landing"
  },
  {
   "start": 138.215,
   "end": 138.795,
   "text": "on that band"
  },
  {
   "start": 138.795,
   "end": 139.675,
   "text": "any more."
  },
  {
   "start": 139.675,
   "end": 140.055,
   "text": "You do not"
  },
  {
   "start": 140.055,
   "end": 140.535,
   "text": "have to believe"
  },
  {
   "start": 140.535,
   "end": 141.155,
   "text": "me."
  },
  {
   "start": 141.155,
   "end": 142.125,
   "text": "One knee only."
  },
  {
   "start": 142.495,
   "end": 142.855,
   "text": "Leave the other"
  },
  {
   "start": 142.855,
   "end": 143.555,
   "text": "bare."
  },
  {
   "start": 143.555,
   "end": 143.855,
   "text": "Go to your"
  },
  {
   "start": 143.855,
   "end": 144.635,
   "text": "own stairs and"
  },
  {
   "start": 144.635,
   "end": 145.585,
   "text": "come down forwards."
  },
  {
   "start": 145.975,
   "end": 146.415,
   "text": "You will know"
  },
  {
   "start": 146.415,
   "end": 147.035,
   "text": "in a minute."
  },
  {
   "start": 147.035,
   "end": 148.355,
   "text": "Two for one,"
  },
  {
   "start": 148.355,
   "end": 148.615,
   "text": "so you do"
  },
  {
   "start": 148.615,
   "end": 149.435,
   "text": "both knees,"
  },
  {
   "start": 149.435,
   "end": 149.755,
   "text": "which is the"
  },
  {
   "start": 149.755,
   "end": 149.995,
   "text": "point."
  },
  {
   "start": 149.995,
   "end": 151.075,
   "text": "Sixty days,"
  },
  {
   "start": 151.075,
   "end": 151.815,
   "text": "and you keep"
  },
  {
   "start": 151.815,
   "end": 152.445,
   "text": "the straps."
  },
  {
   "start": 152.815,
   "end": 153.235,
   "text": "From the Stryde"
  },
  {
   "start": 153.235,
   "end": 154.115,
   "text": "site."
  },
  {
   "start": 154.115,
   "end": 154.795,
   "text": "The copies stretch,"
  },
  {
   "start": 154.795,
   "end": 155.655,
   "text": "and a stretched"
  },
  {
   "start": 155.655,
   "end": 156.675,
   "text": "strap does not"
  },
  {
   "start": 156.675,
   "end": 157.815,
   "text": "hold the spot."
  },
  {
   "start": 157.815,
   "end": 158.095,
   "text": "And if you"
  },
  {
   "start": 158.095,
   "end": 158.815,
   "text": "know somebody whose"
  },
  {
   "start": 158.815,
   "end": 159.535,
   "text": "stairs have started"
  },
  {
   "start": 159.535,
   "end": 160.735,
   "text": "taking them longer,"
  },
  {
   "start": 160.735,
   "end": 161.625,
   "text": "send them this."
  },
  {
   "start": 161.915,
   "end": 162.375,
   "text": "That is the"
  },
  {
   "start": 162.375,
   "end": 162.775,
   "text": "one I would"
