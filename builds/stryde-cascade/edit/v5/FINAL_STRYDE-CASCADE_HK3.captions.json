{
 "cards": [
  {
   "start": 0.0,
   "end": 0.9,
   "text": "When I am"
  },
  {
   "start": 0.9,
   "end": 1.4,
   "text": "asked to move"
  },
  {
   "start": 1.4,
   "end": 1.98,
   "text": "a bed into"
  },
  {
   "start": 1.98,
   "end": 3.02,
   "text": "a front room,"
  },
  {
   "start": 3.02,
   "end": 3.52,
   "text": "the knee has"
  },
  {
   "start": 3.52,
   "end": 4.32,
   "text": "usually been bad"
  },
  {
   "start": 4.32,
   "end": 5.02,
   "text": "for about six"
  },
  {
   "start": 5.02,
   "end": 5.92,
   "text": "years."
  },
  {
   "start": 5.92,
   "end": 6.82,
   "text": "Nobody plans for"
  },
  {
   "start": 6.82,
   "end": 7.5,
   "text": "that."
  },
  {
   "start": 7.5,
   "end": 8.38,
   "text": "It arrives one"
  },
  {
   "start": 8.38,
   "end": 9.32,
   "text": "small change at"
  },
  {
   "start": 9.32,
   "end": 10.08,
   "text": "a time,"
  },
  {
   "start": 10.08,
   "end": 10.48,
   "text": "and I can"
  },
  {
   "start": 10.48,
   "end": 11.36,
   "text": "name every one"
  },
  {
   "start": 11.36,
   "end": 11.875,
   "text": "of them."
  },
  {
   "start": 11.875,
   "end": 12.495,
   "text": "Here is the"
  },
  {
   "start": 12.495,
   "end": 13.095,
   "text": "sequence,"
  },
  {
   "start": 13.095,
   "end": 13.495,
   "text": "and it is"
  },
  {
   "start": 13.495,
   "end": 14.495,
   "text": "almost always the"
  },
  {
   "start": 14.495,
   "end": 15.025,
   "text": "same."
  },
  {
   "start": 15.315,
   "end": 15.995,
   "text": "One knee starts"
  },
  {
   "start": 15.995,
   "end": 16.575,
   "text": "hurting on the"
  },
  {
   "start": 16.575,
   "end": 17.315,
   "text": "stairs."
  },
  {
   "start": 17.315,
   "end": 17.955,
   "text": "So you favour"
  },
  {
   "start": 17.955,
   "end": 18.535,
   "text": "it."
  },
  {
   "start": 18.535,
   "end": 19.095,
   "text": "You lead with"
  },
  {
   "start": 19.095,
   "end": 19.895,
   "text": "the good leg,"
  },
  {
   "start": 19.895,
   "end": 20.955,
   "text": "every step."
  },
  {
   "start": 20.955,
   "end": 21.515,
   "text": "The good leg"
  },
  {
   "start": 21.515,
   "end": 22.135,
   "text": "is now doing"
  },
  {
   "start": 22.135,
   "end": 22.615,
   "text": "the work of"
  },
  {
   "start": 22.615,
   "end": 23.395,
   "text": "two."
  },
  {
   "start": 23.395,
   "end": 23.875,
   "text": "Within a year"
  },
  {
   "start": 23.875,
   "end": 24.535,
   "text": "or two it"
  },
  {
   "start": 24.535,
   "end": 25.735,
   "text": "starts as well."
  },
  {
   "start": 25.735,
   "end": 26.395,
   "text": "Then a rail"
  },
  {
   "start": 26.395,
   "end": 27.375,
   "text": "at the top."
  },
  {
   "start": 27.375,
   "end": 28.155,
   "text": "Then a rail"
  },
  {
   "start": 28.155,
   "end": 28.695,
   "text": "all the way"
  },
  {
   "start": 28.695,
   "end": 29.415,
   "text": "down."
  },
  {
   "start": 29.415,
   "end": 30.195,
   "text": "Then you stop"
  },
  {
   "start": 30.195,
   "end": 30.795,
   "text": "going up in"
  },
  {
   "start": 30.795,
   "end": 31.755,
   "text": "the afternoon."
  },
  {
   "start": 31.755,
   "end": 32.495,
   "text": "Then a bed"
  },
  {
   "start": 32.495,
   "end": 33.275,
   "text": "comes downstairs."
  },
  {
   "start": 33.275,
   "end": 34.215,
   "text": "I am not"
  },
  {
   "start": 34.215,
   "end": 34.835,
   "text": "telling you that"
  },
  {
   "start": 34.835,
   "end": 36.035,
   "text": "to frighten you."
  },
  {
   "start": 36.035,
   "end": 36.815,
   "text": "Every step on"
  },
  {
   "start": 36.815,
   "end": 37.455,
   "text": "that list is"
  },
  {
   "start": 37.455,
   "end": 38.235,
   "text": "a response to"
  },
  {
   "start": 38.235,
   "end": 39.215,
   "text": "weight landing in"
  },
  {
   "start": 39.215,
   "end": 39.835,
   "text": "one place."
  },
  {
   "start": 39.835,
   "end": 41.215,
   "text": "Two centimetres below"
  },
  {
   "start": 41.215,
   "end": 42.095,
   "text": "your kneecap there"
  },
  {
   "start": 42.095,
   "end": 42.535,
   "text": "is a band"
  },
  {
   "start": 42.535,
   "end": 43.395,
   "text": "of tendon about"
  },
  {
   "start": 43.395,
   "end": 43.955,
   "text": "as wide as"
  },
  {
   "start": 43.955,
   "end": 44.605,
   "text": "your thumb."
  },
  {
   "start": 44.915,
   "end": 45.515,
   "text": "Every step you"
  },
  {
   "start": 45.515,
   "end": 46.475,
   "text": "take lands on"
  },
  {
   "start": 46.475,
   "end": 47.235,
   "text": "it."
  },
  {
   "start": 47.235,
   "end": 48.415,
   "text": "Seventeen times your"
  },
  {
   "start": 48.415,
   "end": 49.295,
   "text": "bodyweight."
  },
  {
   "start": 49.295,
   "end": 49.815,
   "text": "Put your finger"
  },
  {
   "start": 49.815,
   "end": 50.845,
   "text": "there and press."
  },
  {
   "start": 51.175,
   "end": 51.795,
   "text": "That is the"
  },
  {
   "start": 51.795,
   "end": 52.515,
   "text": "band."
  },
  {
   "start": 52.515,
   "end": 53.375,
   "text": "Coming down is"
  },
  {
   "start": 53.375,
   "end": 54.095,
   "text": "worse than going"
  },
  {
   "start": 54.095,
   "end": 54.775,
   "text": "up."
  },
  {
   "start": 54.775,
   "end": 55.455,
   "text": "Going up,"
  },
  {
   "start": 55.455,
   "end": 56.195,
   "text": "your muscles lift"
  },
  {
   "start": 56.195,
   "end": 56.735,
   "text": "you."
  },
  {
   "start": 56.735,
   "end": 57.835,
   "text": "Coming down,"
  },
  {
   "start": 57.835,
   "end": 58.795,
   "text": "nothing does."
  },
  {
   "start": 58.795,
   "end": 59.395,
   "text": "You are catching"
  },
  {
   "start": 59.395,
   "end": 59.975,
   "text": "yourself,"
  },
  {
   "start": 59.975,
   "end": 60.715,
   "text": "and the catch"
  },
  {
   "start": 60.715,
   "end": 61.475,
   "text": "lands on that"
  },
  {
   "start": 61.475,
   "end": 62.215,
   "text": "band."
  },
  {
   "start": 62.215,
   "end": 62.875,
   "text": "The pain is"
  },
  {
   "start": 62.875,
   "end": 63.495,
   "text": "not the first"
  },
  {
   "start": 63.495,
   "end": 64.375,
   "text": "thing that happened."
  },
  {
   "start": 64.375,
   "end": 64.955,
   "text": "It is the"
  },
  {
   "start": 64.955,
   "end": 65.635,
   "text": "first thing you"
  },
  {
   "start": 65.635,
   "end": 66.015,
   "text": "noticed."
  },
  {
   "start": 66.015,
   "end": 66.975,
   "text": "You have been"
  },
  {
   "start": 66.975,
   "end": 67.695,
   "text": "told it is"
  },
  {
   "start": 67.695,
   "end": 68.415,
   "text": "your age."
  },
  {
   "start": 68.415,
   "end": 69.395,
   "text": "Or your weight."
  },
  {
   "start": 69.395,
   "end": 70.155,
   "text": "Or that the"
  },
  {
   "start": 70.155,
   "end": 71.235,
   "text": "muscle is weak."
  },
  {
   "start": 71.235,
   "end": 72.055,
   "text": "Sometimes that is"
  },
  {
   "start": 72.055,
   "end": 72.875,
   "text": "part of it."
  },
  {
   "start": 72.875,
   "end": 73.475,
   "text": "It has never"
  },
  {
   "start": 73.475,
   "end": 73.995,
   "text": "been the whole"
  },
  {
   "start": 73.995,
   "end": 74.655,
   "text": "of it."
  },
  {
   "start": 74.655,
   "end": 75.515,
   "text": "The physio helps"
  },
  {
   "start": 75.515,
   "end": 76.435,
   "text": "and then stops"
  },
  {
   "start": 76.435,
   "end": 77.235,
   "text": "helping."
  },
  {
   "start": 77.235,
   "end": 78.015,
   "text": "The gel sits"
  },
  {
   "start": 78.015,
   "end": 79.015,
   "text": "on your skin."
  },
  {
   "start": 79.015,
   "end": 79.855,
   "text": "The pills switch"
  },
  {
   "start": 79.855,
   "end": 80.975,
   "text": "the alarm off."
  },
  {
   "start": 80.975,
   "end": 82.015,
   "text": "The sleeve squeezes"
  },
  {
   "start": 82.015,
   "end": 82.795,
   "text": "the whole knee"
  },
  {
   "start": 82.795,
   "end": 83.595,
   "text": "and leaves that"
  },
  {
   "start": 83.595,
   "end": 85.395,
   "text": "band carrying everything."
  },
  {
   "start": 85.395,
   "end": 85.775,
   "text": "None of them"
  },
  {
   "start": 85.775,
   "end": 86.735,
   "text": "are wrong."
  },
  {
   "start": 86.735,
   "end": 87.215,
   "text": "None of them"
  },
  {
   "start": 87.215,
   "end": 87.915,
   "text": "move the weight"
  },
  {
   "start": 87.915,
   "end": 88.895,
   "text": "off the band,"
  },
  {
   "start": 88.895,
   "end": 89.635,
   "text": "and that is"
  },
  {
   "start": 89.635,
   "end": 90.455,
   "text": "the only thing"
  },
  {
   "start": 90.455,
   "end": 91.155,
   "text": "that stops the"
  },
  {
   "start": 91.155,
   "end": 92.015,
   "text": "sequence."
  },
  {
   "start": 92.015,
   "end": 92.555,
   "text": "The strap I"
  },
  {
   "start": 92.555,
   "end": 93.015,
   "text": "keep in the"
  },
  {
   "start": 93.015,
   "end": 93.655,
   "text": "van now is"
  },
  {
   "start": 93.655,
   "end": 94.455,
   "text": "called Stryde."
  },
  {
   "start": 94.455,
   "end": 95.435,
   "text": "It sits two"
  },
  {
   "start": 95.435,
   "end": 96.435,
   "text": "centimetres below the"
  },
  {
   "start": 96.435,
   "end": 96.895,
   "text": "kneecap,"
  },
  {
   "start": 96.895,
   "end": 98.035,
   "text": "on the tendon."
  },
  {
   "start": 98.035,
   "end": 99.015,
   "text": "It never crosses"
  },
  {
   "start": 99.015,
   "end": 99.785,
   "text": "the joint."
  },
  {
   "start": 100.075,
   "end": 100.455,
   "text": "There is a"
  },
  {
   "start": 100.455,
   "end": 101.575,
   "text": "silicone pad inside"
  },
  {
   "start": 101.575,
   "end": 102.535,
   "text": "that holds pressure"
  },
  {
   "start": 102.535,
   "end": 103.215,
   "text": "on that one"
  },
  {
   "start": 103.215,
   "end": 104.315,
   "text": "band instead of"
  },
  {
   "start": 104.315,
   "end": 104.935,
   "text": "spreading it round"
  },
  {
   "start": 104.935,
   "end": 106.055,
   "text": "the whole knee."
  },
  {
   "start": 106.055,
   "end": 106.655,
   "text": "Your weight gets"
  },
  {
   "start": 106.655,
   "end": 107.555,
   "text": "caught and moved"
  },
  {
   "start": 107.555,
   "end": 108.295,
   "text": "off the worn"
  },
  {
   "start": 108.295,
   "end": 109.175,
   "text": "part before it"
  },
  {
   "start": 109.175,
   "end": 110.255,
   "text": "reaches the joint."
  },
  {
   "start": 110.255,
   "end": 111.135,
   "text": "The placement is"
  },
  {
   "start": 111.135,
   "end": 112.495,
   "text": "the whole thing."
  },
  {
   "start": 112.495,
   "end": 112.975,
   "text": "A little too"
  },
  {
   "start": 112.975,
   "end": 113.875,
   "text": "high and it"
  },
  {
   "start": 113.875,
   "end": 114.335,
   "text": "is a sleeve"
  },
  {
   "start": 114.335,
   "end": 114.695,
   "text": "again."
  },
  {
   "start": 114.695,
   "end": 116.155,
   "text": "Thirty four percent"
  },
  {
   "start": 116.155,
   "end": 117.205,
   "text": "less strain."
  },
  {
   "start": 117.555,
   "end": 118.165,
   "text": "Measured."
  },
  {
   "start": 118.435,
   "end": 119.235,
   "text": "Three years with"
  },
  {
   "start": 119.235,
   "end": 120.195,
   "text": "orthopedic surgeons."
  },
  {
   "start": 120.195,
   "end": 121.795,
   "text": "Two hundred thousand"
  },
  {
   "start": 121.795,
   "end": 122.935,
   "text": "people wearing one."
  },
  {
   "start": 122.935,
   "end": 123.455,
   "text": "I am not"
  },
  {
   "start": 123.455,
   "end": 124.075,
   "text": "paid by them."
  },
  {
   "start": 124.075,
   "end": 125.235,
   "text": "I started carrying"
  },
  {
   "start": 125.235,
   "end": 125.895,
   "text": "a couple because"
  },
  {
   "start": 125.895,
   "end": 126.515,
   "text": "I was tired"
  },
  {
   "start": 126.515,
   "end": 127.095,
   "text": "of fitting the"
  },
  {
   "start": 127.095,
   "end": 127.845,
   "text": "second rail."
  },
  {
   "start": 128.195,
   "end": 128.915,
   "text": "Three houses this"
  },
  {
   "start": 128.915,
   "end": 129.535,
   "text": "year have not"
  },
  {
   "start": 129.535,
   "end": 130.695,
   "text": "called me back."
  },
  {
   "start": 130.695,
   "end": 131.375,
   "text": "That is not"
  },
  {
   "start": 131.375,
   "end": 132.155,
   "text": "a study."
  },
  {
   "start": 132.155,
   "end": 132.595,
   "text": "It is just"
  },
  {
   "start": 132.595,
   "end": 132.915,
   "text": "what I have"
  },
  {
   "start": 132.915,
   "end": 133.535,
   "text": "seen."
  },
  {
   "start": 133.535,
   "end": 134.235,
   "text": "Not because the"
  },
  {
   "start": 134.235,
   "end": 135.495,
   "text": "arthritis is gone."
  },
  {
   "start": 135.495,
   "end": 136.075,
   "text": "It is still"
  },
  {
   "start": 136.075,
   "end": 136.835,
   "text": "there."
  },
  {
   "start": 136.835,
   "end": 137.515,
   "text": "Because the weight"
  },
  {
   "start": 137.515,
   "end": 138.275,
   "text": "is not landing"
  },
  {
   "start": 138.275,
   "end": 138.915,
   "text": "on that band"
  },
  {
   "start": 138.915,
   "end": 139.755,
   "text": "any more."
  },
  {
   "start": 139.755,
   "end": 140.095,
   "text": "You do not"
  },
  {
   "start": 140.095,
   "end": 140.615,
   "text": "have to believe"
  },
  {
   "start": 140.615,
   "end": 141.255,
   "text": "me."
  },
  {
   "start": 141.255,
   "end": 142.455,
   "text": "One knee only."
  },
  {
   "start": 142.455,
   "end": 142.915,
   "text": "Leave the other"
  },
  {
   "start": 142.915,
   "end": 143.575,
   "text": "bare."
  },
  {
   "start": 143.575,
   "end": 143.935,
   "text": "Go to your"
  },
  {
   "start": 143.935,
   "end": 144.735,
   "text": "own stairs and"
  },
  {
   "start": 144.735,
   "end": 146.015,
   "text": "come down forwards."
  },
  {
   "start": 146.015,
   "end": 146.535,
   "text": "You will know"
  },
  {
   "start": 146.535,
   "end": 147.595,
   "text": "in a minute."
  },
  {
   "start": 147.595,
   "end": 148.315,
   "text": "Two for one,"
  },
  {
   "start": 148.315,
   "end": 148.695,
   "text": "so you do"
  },
  {
   "start": 148.695,
   "end": 149.355,
   "text": "both knees,"
  },
  {
   "start": 149.355,
   "end": 149.855,
   "text": "which is the"
  },
  {
   "start": 149.855,
   "end": 150.115,
   "text": "point."
  },
  {
   "start": 150.115,
   "end": 151.255,
   "text": "Sixty days,"
  },
  {
   "start": 151.255,
   "end": 151.915,
   "text": "and you keep"
  },
  {
   "start": 151.915,
   "end": 152.435,
   "text": "the straps."
  },
  {
   "start": 152.435,
   "end": 153.395,
   "text": "From the Stryde"
  },
  {
   "start": 153.395,
   "end": 154.195,
   "text": "site."
  },
  {
   "start": 154.195,
   "end": 155.035,
   "text": "The copies stretch,"
  },
  {
   "start": 155.035,
   "end": 155.915,
   "text": "and a stretched"
  },
  {
   "start": 155.915,
   "end": 156.775,
   "text": "strap does not"
  },
  {
   "start": 156.775,
   "end": 157.915,
   "text": "hold the spot."
  },
  {
   "start": 157.915,
   "end": 158.155,
   "text": "And if you"
  },
  {
   "start": 158.155,
   "end": 158.915,
   "text": "know somebody whose"
  },
  {
   "start": 158.915,
   "end": 159.675,
   "text": "stairs have started"
  },
  {
   "start": 159.675,
   "end": 160.995,
   "text": "taking them longer,"
  },
  {
   "start": 160.995,
   "end": 162.015,
   "text": "send them this."
  },
  {
   "start": 162.015,
   "end": 162.435,
   "text": "That is the"
  },
  {
   "start": 162.435,
   "end": 162.835,
   "text": "one I would"
  },
