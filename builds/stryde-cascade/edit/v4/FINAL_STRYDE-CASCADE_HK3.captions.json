{
 "cards": [
  {
   "start": 0.0,
   "end": 0.94,
   "text": "When I am"
  },
  {
   "start": 0.94,
   "end": 1.54,
   "text": "asked to move"
  },
  {
   "start": 1.54,
   "end": 2.1,
   "text": "a bed into"
  },
  {
   "start": 2.1,
   "end": 3.16,
   "text": "a front room,"
  },
  {
   "start": 3.16,
   "end": 3.62,
   "text": "the knee has"
  },
  {
   "start": 3.62,
   "end": 4.52,
   "text": "usually been bad"
  },
  {
   "start": 4.52,
   "end": 5.34,
   "text": "for about six"
  },
  {
   "start": 5.34,
   "end": 6.01,
   "text": "years."
  },
  {
   "start": 6.54,
   "end": 7.62,
   "text": "Nobody plans for"
  },
  {
   "start": 7.62,
   "end": 8.09,
   "text": "that."
  },
  {
   "start": 8.44,
   "end": 9.3,
   "text": "It arrives one"
  },
  {
   "start": 9.3,
   "end": 10.36,
   "text": "small change at"
  },
  {
   "start": 10.36,
   "end": 11.02,
   "text": "a time,"
  },
  {
   "start": 11.02,
   "end": 11.54,
   "text": "and I can"
  },
  {
   "start": 11.54,
   "end": 12.42,
   "text": "name every one"
  },
  {
   "start": 12.42,
   "end": 13.125,
   "text": "of them."
  },
  {
   "start": 13.125,
   "end": 13.785,
   "text": "Here is the"
  },
  {
   "start": 13.785,
   "end": 14.485,
   "text": "sequence,"
  },
  {
   "start": 14.485,
   "end": 14.825,
   "text": "and it is"
  },
  {
   "start": 14.825,
   "end": 15.905,
   "text": "almost always the"
  },
  {
   "start": 15.905,
   "end": 16.415,
   "text": "same."
  },
  {
   "start": 16.885,
   "end": 17.425,
   "text": "One knee starts"
  },
  {
   "start": 17.425,
   "end": 18.065,
   "text": "hurting on the"
  },
  {
   "start": 18.065,
   "end": 18.575,
   "text": "stairs."
  },
  {
   "start": 18.845,
   "end": 19.545,
   "text": "So you favour"
  },
  {
   "start": 19.545,
   "end": 20.285,
   "text": "it."
  },
  {
   "start": 20.285,
   "end": 20.845,
   "text": "You lead with"
  },
  {
   "start": 20.845,
   "end": 21.685,
   "text": "the good leg,"
  },
  {
   "start": 21.685,
   "end": 22.865,
   "text": "every step."
  },
  {
   "start": 22.865,
   "end": 23.425,
   "text": "The good leg"
  },
  {
   "start": 23.425,
   "end": 24.145,
   "text": "is now doing"
  },
  {
   "start": 24.145,
   "end": 24.605,
   "text": "the work of"
  },
  {
   "start": 24.605,
   "end": 25.095,
   "text": "two."
  },
  {
   "start": 25.445,
   "end": 26.005,
   "text": "Within a year"
  },
  {
   "start": 26.005,
   "end": 26.645,
   "text": "or two it"
  },
  {
   "start": 26.645,
   "end": 27.535,
   "text": "starts as well."
  },
  {
   "start": 28.105,
   "end": 28.525,
   "text": "Then a rail"
  },
  {
   "start": 28.525,
   "end": 29.255,
   "text": "at the top."
  },
  {
   "start": 29.645,
   "end": 30.245,
   "text": "Then a rail"
  },
  {
   "start": 30.245,
   "end": 30.805,
   "text": "all the way"
  },
  {
   "start": 30.805,
   "end": 31.335,
   "text": "down."
  },
  {
   "start": 31.685,
   "end": 32.245,
   "text": "Then you stop"
  },
  {
   "start": 32.245,
   "end": 32.905,
   "text": "going up in"
  },
  {
   "start": 32.905,
   "end": 33.395,
   "text": "the afternoon."
  },
  {
   "start": 34.085,
   "end": 34.785,
   "text": "Then a bed"
  },
  {
   "start": 34.785,
   "end": 35.515,
   "text": "comes downstairs."
  },
  {
   "start": 36.205,
   "end": 36.685,
   "text": "I am not"
  },
  {
   "start": 36.685,
   "end": 37.425,
   "text": "telling you that"
  },
  {
   "start": 37.425,
   "end": 38.225,
   "text": "to frighten you."
  },
  {
   "start": 38.225,
   "end": 39.625,
   "text": "Every step on"
  },
  {
   "start": 39.625,
   "end": 40.345,
   "text": "that list is"
  },
  {
   "start": 40.345,
   "end": 41.145,
   "text": "a response to"
  },
  {
   "start": 41.145,
   "end": 42.125,
   "text": "weight landing in"
  },
  {
   "start": 42.125,
   "end": 42.975,
   "text": "one place."
  },
  {
   "start": 43.285,
   "end": 44.325,
   "text": "Two centimetres below"
  },
  {
   "start": 44.325,
   "end": 45.345,
   "text": "your kneecap there"
  },
  {
   "start": 45.345,
   "end": 45.785,
   "text": "is a band"
  },
  {
   "start": 45.785,
   "end": 46.645,
   "text": "of tendon about"
  },
  {
   "start": 46.645,
   "end": 47.345,
   "text": "as wide as"
  },
  {
   "start": 47.345,
   "end": 48.245,
   "text": "your thumb."
  },
  {
   "start": 48.245,
   "end": 49.045,
   "text": "Every step you"
  },
  {
   "start": 49.045,
   "end": 50.125,
   "text": "take lands on"
  },
  {
   "start": 50.125,
   "end": 50.515,
   "text": "it."
  },
  {
   "start": 50.845,
   "end": 52.105,
   "text": "Seventeen times your"
  },
  {
   "start": 52.105,
   "end": 53.085,
   "text": "bodyweight."
  },
  {
   "start": 53.085,
   "end": 53.665,
   "text": "Put your finger"
  },
  {
   "start": 53.665,
   "end": 54.595,
   "text": "there and press."
  },
  {
   "start": 55.145,
   "end": 55.685,
   "text": "That is the"
  },
  {
   "start": 55.685,
   "end": 56.405,
   "text": "band."
  },
  {
   "start": 56.405,
   "end": 57.285,
   "text": "Coming down is"
  },
  {
   "start": 57.285,
   "end": 58.045,
   "text": "worse than going"
  },
  {
   "start": 58.045,
   "end": 58.785,
   "text": "up."
  },
  {
   "start": 58.785,
   "end": 59.545,
   "text": "Going up,"
  },
  {
   "start": 59.545,
   "end": 60.305,
   "text": "your muscles lift"
  },
  {
   "start": 60.305,
   "end": 61.025,
   "text": "you."
  },
  {
   "start": 61.025,
   "end": 61.985,
   "text": "Coming down,"
  },
  {
   "start": 61.985,
   "end": 62.875,
   "text": "nothing does."
  },
  {
   "start": 63.205,
   "end": 63.805,
   "text": "You are catching"
  },
  {
   "start": 63.805,
   "end": 64.645,
   "text": "yourself,"
  },
  {
   "start": 64.645,
   "end": 65.145,
   "text": "and the catch"
  },
  {
   "start": 65.145,
   "end": 66.085,
   "text": "lands on that"
  },
  {
   "start": 66.085,
   "end": 66.405,
   "text": "band."
  },
  {
   "start": 66.405,
   "end": 67.585,
   "text": "The pain is"
  },
  {
   "start": 67.585,
   "end": 68.245,
   "text": "not the first"
  },
  {
   "start": 68.245,
   "end": 69.215,
   "text": "thing that happened."
  },
  {
   "start": 69.505,
   "end": 69.845,
   "text": "It is the"
  },
  {
   "start": 69.845,
   "end": 70.525,
   "text": "first thing you"
  },
  {
   "start": 70.525,
   "end": 71.075,
   "text": "noticed."
  },
  {
   "start": 71.625,
   "end": 72.125,
   "text": "You have been"
  },
  {
   "start": 72.125,
   "end": 72.845,
   "text": "told it is"
  },
  {
   "start": 72.845,
   "end": 73.725,
   "text": "your age."
  },
  {
   "start": 73.725,
   "end": 74.765,
   "text": "Or your weight."
  },
  {
   "start": 74.765,
   "end": 75.365,
   "text": "Or that the"
  },
  {
   "start": 75.365,
   "end": 76.565,
   "text": "muscle is weak."
  },
  {
   "start": 76.565,
   "end": 77.525,
   "text": "Sometimes that is"
  },
  {
   "start": 77.525,
   "end": 78.405,
   "text": "part of it."
  },
  {
   "start": 78.405,
   "end": 79.105,
   "text": "It has never"
  },
  {
   "start": 79.105,
   "end": 79.685,
   "text": "been the whole"
  },
  {
   "start": 79.685,
   "end": 80.485,
   "text": "of it."
  },
  {
   "start": 80.485,
   "end": 81.245,
   "text": "The physio helps"
  },
  {
   "start": 81.245,
   "end": 82.245,
   "text": "and then stops"
  },
  {
   "start": 82.245,
   "end": 82.855,
   "text": "helping."
  },
  {
   "start": 83.265,
   "end": 83.885,
   "text": "The gel sits"
  },
  {
   "start": 83.885,
   "end": 84.735,
   "text": "on your skin."
  },
  {
   "start": 85.105,
   "end": 85.865,
   "text": "The pills switch"
  },
  {
   "start": 85.865,
   "end": 86.895,
   "text": "the alarm off."
  },
  {
   "start": 87.225,
   "end": 88.245,
   "text": "The sleeve squeezes"
  },
  {
   "start": 88.245,
   "end": 89.045,
   "text": "the whole knee"
  },
  {
   "start": 89.045,
   "end": 89.865,
   "text": "and leaves that"
  },
  {
   "start": 89.865,
   "end": 91.395,
   "text": "band carrying everything."
  },
  {
   "start": 91.745,
   "end": 92.345,
   "text": "None of them"
  },
  {
   "start": 92.345,
   "end": 92.975,
   "text": "are wrong."
  },
  {
   "start": 93.345,
   "end": 93.945,
   "text": "None of them"
  },
  {
   "start": 93.945,
   "end": 94.565,
   "text": "move the weight"
  },
  {
   "start": 94.565,
   "end": 95.245,
   "text": "off the band,"
  },
  {
   "start": 95.245,
   "end": 96.365,
   "text": "and that is"
  },
  {
   "start": 96.365,
   "end": 97.205,
   "text": "the only thing"
  },
  {
   "start": 97.205,
   "end": 97.885,
   "text": "that stops the"
  },
  {
   "start": 97.885,
   "end": 98.455,
   "text": "sequence."
  },
  {
   "start": 98.945,
   "end": 99.505,
   "text": "The strap I"
  },
  {
   "start": 99.505,
   "end": 99.925,
   "text": "keep in the"
  },
  {
   "start": 99.925,
   "end": 100.625,
   "text": "van now is"
  },
  {
   "start": 100.625,
   "end": 101.905,
   "text": "called Stryde."
  },
  {
   "start": 101.905,
   "end": 102.505,
   "text": "It sits two"
  },
  {
   "start": 102.505,
   "end": 103.625,
   "text": "centimetres below the"
  },
  {
   "start": 103.625,
   "end": 104.045,
   "text": "kneecap,"
  },
  {
   "start": 104.045,
   "end": 105.015,
   "text": "on the tendon."
  },
  {
   "start": 105.405,
   "end": 106.365,
   "text": "It never crosses"
  },
  {
   "start": 106.365,
   "end": 107.155,
   "text": "the joint."
  },
  {
   "start": 107.665,
   "end": 108.065,
   "text": "There is a"
  },
  {
   "start": 108.065,
   "end": 109.185,
   "text": "silicone pad inside"
  },
  {
   "start": 109.185,
   "end": 110.165,
   "text": "that holds pressure"
  },
  {
   "start": 110.165,
   "end": 110.965,
   "text": "on that one"
  },
  {
   "start": 110.965,
   "end": 111.985,
   "text": "band instead of"
  },
  {
   "start": 111.985,
   "end": 112.665,
   "text": "spreading it round"
  },
  {
   "start": 112.665,
   "end": 113.635,
   "text": "the whole knee."
  },
  {
   "start": 113.905,
   "end": 114.545,
   "text": "Your weight gets"
  },
  {
   "start": 114.545,
   "end": 115.405,
   "text": "caught and moved"
  },
  {
   "start": 115.405,
   "end": 116.145,
   "text": "off the worn"
  },
  {
   "start": 116.145,
   "end": 117.145,
   "text": "part before it"
  },
  {
   "start": 117.145,
   "end": 118.075,
   "text": "reaches the joint."
  },
  {
   "start": 118.485,
   "end": 119.245,
   "text": "The placement is"
  },
  {
   "start": 119.245,
   "end": 120.525,
   "text": "the whole thing."
  },
  {
   "start": 120.525,
   "end": 121.065,
   "text": "A little too"
  },
  {
   "start": 121.065,
   "end": 121.945,
   "text": "high and it"
  },
  {
   "start": 121.945,
   "end": 122.365,
   "text": "is a sleeve"
  },
  {
   "start": 122.365,
   "end": 122.685,
   "text": "again."
  },
  {
   "start": 122.685,
   "end": 124.305,
   "text": "Thirty four percent"
  },
  {
   "start": 124.305,
   "end": 125.505,
   "text": "less strain."
  },
  {
   "start": 125.505,
   "end": 126.505,
   "text": "Measured."
  },
  {
   "start": 126.505,
   "end": 127.485,
   "text": "Three years with"
  },
  {
   "start": 127.485,
   "end": 128.265,
   "text": "orthopedic surgeons."
  },
  {
   "start": 128.265,
   "end": 130.185,
   "text": "Two hundred thousand"
  },
  {
   "start": 130.185,
   "end": 131.485,
   "text": "people wearing one."
  },
  {
   "start": 131.485,
   "end": 131.885,
   "text": "I am not"
  },
  {
   "start": 131.885,
   "end": 132.775,
   "text": "paid by them."
  },
  {
   "start": 133.045,
   "end": 133.725,
   "text": "I started carrying"
  },
  {
   "start": 133.725,
   "end": 134.605,
   "text": "a couple because"
  },
  {
   "start": 134.605,
   "end": 135.305,
   "text": "I was tired"
  },
  {
   "start": 135.305,
   "end": 135.905,
   "text": "of fitting the"
  },
  {
   "start": 135.905,
   "end": 136.945,
   "text": "second rail."
  },
  {
   "start": 136.945,
   "end": 137.865,
   "text": "Three houses this"
  },
  {
   "start": 137.865,
   "end": 138.605,
   "text": "year have not"
  },
  {
   "start": 138.605,
   "end": 139.515,
   "text": "called me back."
  },
  {
   "start": 139.785,
   "end": 140.465,
   "text": "That is not"
  },
  {
   "start": 140.465,
   "end": 141.345,
   "text": "a study."
  },
  {
   "start": 141.345,
   "end": 141.765,
   "text": "It is just"
  },
  {
   "start": 141.765,
   "end": 142.225,
   "text": "what I have"
  },
  {
   "start": 142.225,
   "end": 142.845,
   "text": "seen."
  },
  {
   "start": 142.845,
   "end": 143.585,
   "text": "Not because the"
  },
  {
   "start": 143.585,
   "end": 144.865,
   "text": "arthritis is gone."
  },
  {
   "start": 144.865,
   "end": 145.385,
   "text": "It is still"
  },
  {
   "start": 145.385,
   "end": 146.165,
   "text": "there."
  },
  {
   "start": 146.165,
   "end": 146.885,
   "text": "Because the weight"
  },
  {
   "start": 146.885,
   "end": 147.785,
   "text": "is not landing"
  },
  {
   "start": 147.785,
   "end": 148.345,
   "text": "on that band"
  },
  {
   "start": 148.345,
   "end": 149.325,
   "text": "any more."
  },
  {
   "start": 149.325,
   "end": 149.765,
   "text": "You do not"
  },
  {
   "start": 149.765,
   "end": 150.305,
   "text": "have to believe"
  },
  {
   "start": 150.305,
   "end": 150.815,
   "text": "me."
  },
  {
   "start": 151.165,
   "end": 151.805,
   "text": "One knee only."
  },
  {
   "start": 151.805,
   "end": 152.825,
   "text": "Leave the other"
  },
  {
   "start": 152.825,
   "end": 153.465,
   "text": "bare."
  },
  {
   "start": 153.465,
   "end": 153.905,
   "text": "Go to your"
  },
  {
   "start": 153.905,
   "end": 154.745,
   "text": "own stairs and"
  },
  {
   "start": 154.745,
   "end": 155.715,
   "text": "come down forwards."
  },
  {
   "start": 156.165,
   "end": 156.725,
   "text": "You will know"
  },
  {
   "start": 156.725,
   "end": 157.805,
   "text": "in a minute."
  },
  {
   "start": 157.805,
   "end": 158.685,
   "text": "Two for one,"
  },
  {
   "start": 158.685,
   "end": 159.025,
   "text": "so you do"
  },
  {
   "start": 159.025,
   "end": 159.545,
   "text": "both knees,"
  },
  {
   "start": 159.545,
   "end": 160.305,
   "text": "which is the"
  },
  {
   "start": 160.305,
   "end": 160.525,
   "text": "point."
  },
  {
   "start": 160.525,
   "end": 161.645,
   "text": "Sixty days,"
  },
  {
   "start": 161.645,
   "end": 162.465,
   "text": "and you keep"
  },
  {
   "start": 162.465,
   "end": 163.135,
   "text": "the straps."
  },
  {
   "start": 163.525,
   "end": 163.965,
   "text": "From the Stryde"
  },
  {
   "start": 163.965,
   "end": 164.785,
   "text": "site."
  },
  {
   "start": 164.785,
   "end": 165.505,
   "text": "The copies stretch,"
  },
  {
   "start": 165.505,
   "end": 166.385,
   "text": "and a stretched"
  },
  {
   "start": 166.385,
   "end": 167.345,
   "text": "strap does not"
  },
  {
   "start": 167.345,
   "end": 168.235,
   "text": "hold the spot."
  },
  {
   "start": 168.545,
   "end": 168.865,
   "text": "And if you"
  },
  {
   "start": 168.865,
   "end": 169.865,
   "text": "know somebody whose"
  },
  {
   "start": 169.865,
   "end": 170.545,
   "text": "stairs have started"
  },
  {
   "start": 170.545,
   "end": 171.925,
   "text": "taking them longer,"
  },
  {
   "start": 171.925,
   "end": 173.085,
   "text": "send them this."
  },
  {
   "start": 173.085,
   "end": 173.705,
   "text": "That is the"
  },
  {
   "start": 173.705,
   "end": 174.245,
   "text": "one I would"
  },
